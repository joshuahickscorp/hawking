class ProtocolError(Exception):
    pass


class ToolError(Exception):
    pass


class ModelError(Exception):
    pass


def utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat()


def estimate_tokens(text: Any) -> int:
    return max(1, len(str(text)) // 4)


def truncate_text(text: Any, max_chars: int = 12000, max_lines: int = 500) -> Tuple[str, bool]:
    if text is None:
        return "", False
    text = str(text)
    truncated = False
    lines = text.splitlines()
    if len(lines) > max_lines:
        lines = lines[:max_lines]
        truncated = True
    out = "\n".join(lines)
    if len(out) > max_chars:
        out = out[:max_chars]
        truncated = True
    if truncated:
        out += "\n...[truncated]"
    return out, truncated


def _within_root(root: str, path: str) -> bool:
    root = os.path.realpath(root)
    full = os.path.realpath(path if os.path.isabs(path) else os.path.join(root, path))
    return full == root or full.startswith(root + os.sep)


class RepositoryGuard:
    def __init__(self, root: str):
        self.root = os.path.realpath(root)

    @classmethod
    def detect(cls, cwd: Optional[str] = None) -> "RepositoryGuard":
        cwd = os.path.realpath(cwd or os.getcwd())
        root = cwd
        try:
            proc = subprocess.run(
                ["git", "rev-parse", "--show-toplevel"],
                cwd=cwd,
                capture_output=True,
                text=True,
                timeout=5,
            )
            if proc.returncode == 0 and proc.stdout.strip():
                root = os.path.realpath(proc.stdout.strip())
        except Exception:
            pass
        return cls(root)

    def resolve(self, path: Any) -> str:
        if path is None or str(path).strip() == "":
            raise ToolError("path required")
        p = str(path)
        full = os.path.realpath(p if os.path.isabs(p) else os.path.join(self.root, p))
        if full != self.root and not full.startswith(self.root + os.sep):
            raise ToolError(f"path escapes repository root: {p}")
        return full

    def relative(self, path: str) -> str:
        return os.path.relpath(path, self.root)


def _reject(message: str) -> None:
    raise ToolError(message)


def _validate_git(argv: List[str], root: str) -> List[str]:
    if len(argv) < 2:
        _reject("git requires a subcommand")
    sub = argv[1]
    config = {
        "status": (
            {"--porcelain", "--short", "--branch", "--no-color"},
            {"--porcelain", "--untracked-files"},
            set(),
            0,
        ),
        "diff": (
            {"--cached", "--staged", "--stat", "--name-only", "--no-color", "--shortstat", "--numstat"},
            set(),
            set(),
            1,
        ),
        "log": (
            {"--oneline", "--stat", "--name-only", "--no-color"},
            {"--max-count", "--pretty", "--since"},
            {"-n"},
            1,
        ),
        "show": (
            {"--stat", "--name-only", "--no-color"},
            {"--pretty"},
            set(),
            1,
        ),
    }
    if sub not in config:
        _reject(f"git {sub} not admitted")
    bool_flags, value_flags, short_value_flags, max_positional = config[sub]
    i = 2
    positional = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            while i < len(argv):
                positional += 1
                if positional > max_positional:
                    _reject(f"git {sub} has too many positional arguments")
                i += 1
            break
        if arg.startswith("-"):
            if "=" in arg:
                key = arg.split("=", 1)[0]
                if key in value_flags:
                    i += 1
                    continue
                _reject(f"git {sub} flag {arg} not admitted")
            elif arg in short_value_flags:
                if i + 1 >= len(argv):
                    _reject(f"git {sub} flag {arg} requires a value")
                i += 2
                continue
            elif arg in bool_flags:
                i += 1
                continue
            _reject(f"git {sub} flag {arg} not admitted")
        else:
            positional += 1
            if positional > max_positional:
                _reject(f"git {sub} has too many positional arguments")
            i += 1
    return argv


def _validate_rg(argv: List[str], root: str) -> List[str]:
    bool_flags = {
        "-n",
        "--line-number",
        "-l",
        "--files-with-matches",
        "-c",
        "--count",
        "-F",
        "--fixed-strings",
        "-i",
        "--ignore-case",
        "--no-heading",
        "-j",
        "--jobs",
        "-u",
        "--hidden",
        "-uu",
        "--no-ignore",
        "--smart-case",
        "-a",
        "--text",
        "-N",
        "--no-filename",
        "-0",
        "--null",
    }
    value_keys = {
        "--glob",
        "--type",
        "--max-count",
        "--max-depth",
        "--color",
        "--max-filesize",
        "--context",
        "--iglob",
    }
    i = 1
    positional = 0
    path = None
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            while i < len(argv):
                positional += 1
                if positional == 2:
                    path = argv[i]
                elif positional > 2:
                    _reject("rg has too many positional arguments")
                i += 1
            break
        if arg.startswith("-"):
            if "=" in arg:
                key = arg.split("=", 1)[0]
                if key in value_keys:
                    i += 1
                    continue
                _reject(f"rg flag {arg} not admitted")
            elif arg in bool_flags:
                i += 1
                continue
            _reject(f"rg flag {arg} not admitted")
        else:
            positional += 1
            if positional == 2:
                path = arg
            elif positional > 2:
                _reject("rg has too many positional arguments")
            i += 1
    if positional < 1:
        _reject("rg requires a pattern")
    if path is not None and not _within_root(root, path):
        _reject("rg path escapes repository root")
    return argv


def _validate_cargo(argv: List[str], root: str) -> List[str]:
    if len(argv) < 2 or argv[1] not in {"check", "test"}:
        _reject("cargo check or cargo test required")
    bool_flags = {
        "--workspace",
        "--all",
        "--quiet",
        "--no-default-features",
        "--tests",
        "--lib",
        "--bins",
        "--examples",
        "--no-run",
        "--release",
        "--frozen",
        "--locked",
    }
    value_keys = {
        "--features",
        "--message-format",
        "--color",
        "--profile",
        "--package",
    }
    i = 2
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if arg in {"-p", "--package"}:
            if i + 1 >= len(argv):
                _reject(f"cargo flag {arg} requires a value")
            i += 2
            continue
        if arg.startswith("-"):
            if "=" in arg:
                key = arg.split("=", 1)[0]
                if key in value_keys:
                    i += 1
                    continue
                _reject(f"cargo flag {arg} not admitted")
            elif arg in bool_flags:
                i += 1
                continue
            _reject(f"cargo flag {arg} not admitted")
        else:
            i += 1
    return argv


def _validate_python(argv: List[str], root: str) -> List[str]:
    root = os.path.realpath(root)
    if len(argv) < 2:
        _reject("python requires an argument")
    if argv[1] == "-m":
        if len(argv) < 3 or argv[2] != "unittest":
            _reject("only python -m unittest is admitted")
        rest = argv[3:]
        if rest and rest[0] == "discover":
            i = 1
            while i < len(rest):
                arg = rest[i]
                if arg == "-s":
                    if i + 1 >= len(rest) or rest[i + 1] != "tools/haider":
                        _reject("python -m unittest discover requires -s tools/haider")
                    i += 2
                    continue
                if arg in {"-p", "--pattern", "--top-level-directory"}:
                    if i + 1 >= len(rest):
                        _reject(f"python -m unittest discover flag {arg} requires a value")
                    if arg == "--top-level-directory" and rest[i + 1] != "tools/haider":
                        _reject("python -m unittest discover --top-level-directory must be tools/haider")
                    i += 2
                    continue
                if arg.startswith("-"):
                    i += 1
                    continue
                _reject("unexpected positional argument in python -m unittest discover")
        else:
            for item in rest:
                if item.startswith("-"):
                    continue
                if not item.startswith("tools.haider."):
                    _reject("python -m unittest module must start with tools.haider.")
        return argv
    script = argv[1]
    full = os.path.realpath(script if os.path.isabs(script) else os.path.join(root, script))
    if not _within_root(root, full):
        _reject("python script escapes repository root")
    rel = os.path.relpath(full, root)
    if not rel.startswith("tools" + os.sep + "haider" + os.sep) or not rel.endswith(".py"):
        _reject("python script must be under tools/haider and end with .py")
    return argv


def admit_command(command: str, root: str) -> List[str]:
    if not isinstance(command, str) or not command.strip():
        raise ToolError("command required")
    try:
        argv = shlex.split(command)
    except ValueError as e:
        raise ToolError(f"cannot parse command: {e}") from e
    if not argv:
        raise ToolError("empty command")
    exe = os.path.basename(argv[0])
    if exe in {"sudo", "rm", "killall", "reboot", "shutdown", "sh", "bash", "zsh", "eval"}:
        raise ToolError(f"command {exe} not admitted")
    if exe == "git":
        return _validate_git(argv, root)
    if exe == "rg":
        return _validate_rg(argv, root)
    if exe == "cargo":
        return _validate_cargo(argv, root)
    if exe in {"python", "python3"}:
        return _validate_python(argv, root)
    raise ToolError(f"command {exe} not admitted")


def make_observation(
    root: str,
    tool: str,
    args: Dict[str, Any],
    exit_code: int,
    stdout: str,
    stderr: str,
    elapsed_ms: int,
    truncated: bool,
    ok: bool = True,
    extra: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    obs = {
        "tool": tool,
        "args": args,
        "cwd": root,
        "repository_root": root,
        "exit_code": int(exit_code),
        "stdout": stdout,
        "stderr": stderr,
        "elapsed_ms": int(elapsed_ms),
        "truncated": bool(truncated),
        "timestamp": utc_now_iso(),
        "ok": bool(ok),
    }
    if extra:
        obs.update(extra)
    return obs


class ToolExecutor:
    def __init__(
        self,
        guard: RepositoryGuard,
        max_output_chars: int = 12000,
        max_output_lines: int = 500,
        timeout: float = 30.0,
        max_timeout: float = 300.0,
    ):
        self.guard = guard
        self.root = guard.root
        self.max_output_chars = max_output_chars
        self.max_output_lines = max_output_lines
        self.timeout = timeout
        self.max_timeout = max_timeout

    def _clamp_timeout(self, timeout: Any) -> float:
        try:
            t = float(timeout)
        except Exception:
            t = self.timeout
        return max(0.1, min(t, self.max_timeout))

    def _run(self, argv: List[str], timeout: Any = None) -> Tuple[int, str, str]:
        timeout = self._clamp_timeout(timeout)
        try:
            proc = subprocess.run(
                argv,
                cwd=self.root,
                capture_output=True,
                text=True,
                timeout=timeout,
            )
            return proc.returncode, proc.stdout or "", proc.stderr or ""
        except subprocess.TimeoutExpired as e:
            out = e.stdout or ""
            err = e.stderr or ""
            if isinstance(out, bytes):
                out = out.decode("utf-8", errors="ignore")
            if isinstance(err, bytes):
                err = err.decode("utf-8", errors="ignore")
            return 124, out, (err + "timeout").strip()
        except Exception as e:
            return 1, "", str(e)

    def _search_file(self, file_path: str, pattern: str, results: List[str], max_results: int) -> None:
        try:
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
                for line_no, line in enumerate(f, 1):
                    if pattern in line:
                        results.append(f"{self.guard.relative(file_path)}:{line_no}:{line.rstrip()}")
                        if len(results) >= max_results:
                            return
        except Exception:
            pass

    def _search_fallback(self, pattern: str, path: str, max_results: int) -> List[str]:
        base = self.guard.resolve(path or ".")
        results: List[str] = []
        if os.path.isfile(base):
            self._search_file(base, pattern, results, max_results)
            return results
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [
                d
                for d in dirnames
                if d not in {".git", "target", "node_modules", ".venv", "__pycache__"}
            ]
            for fn in sorted(filenames):
                fp = os.path.join(dirpath, fn)
                self._search_file(fp, pattern, results, max_results)
                if len(results) >= max_results:
                    break
            if len(results) >= max_results:
                break
        return results

    def execute(self, name: str, args: Dict[str, Any]) -> Dict[str, Any]:
        args = args if isinstance(args, dict) else {}
        start = time.monotonic()
        exit_code = 0
        stdout = ""
        stderr = ""
        ok = True
        extra: Optional[Dict[str, Any]] = None
        try:
            if name == "git.status":
                argv = ["git", "status", "--porcelain=v1", "--branch"]
                exit_code, stdout, stderr = self._run(argv)
                ok = exit_code == 0
            elif name == "git.diff":
                argv = ["git", "diff"]
                if args.get("staged"):
                    argv.append("--cached")
                argv.append("--no-color")
                if args.get("path"):
                    self.guard.resolve(args["path"])
                    argv.append(str(args["path"]))
                exit_code, stdout, stderr = self._run(argv)
                ok = exit_code == 0
            elif name == "git.log":
                count = int(args.get("count") or 20)
                count = max(1, min(count, 200))
                argv = ["git", "log", "--oneline", "--no-color", "-n", str(count)]
                if args.get("path"):
                    self.guard.resolve(args["path"])
                    argv.append(str(args["path"]))
                exit_code, stdout, stderr = self._run(argv)
                ok = exit_code == 0
            elif name == "repo.search":
                pattern = str(args.get("pattern", ""))
                if not pattern:
                    raise ToolError("repo.search requires pattern")
                path = str(args.get("path") or ".")
                max_results = int(args.get("max_results") or 50)
                max_results = max(1, min(max_results, 200))
                if shutil.which("rg"):
                    argv = ["rg", "--color=never", "-n", f"--max-count={max_results}", pattern, path]
                    command = " ".join(shlex.quote(a) for a in argv)
                    admit_command(command, self.root)
                    exit_code, stdout, stderr = self._run(argv)
                    ok = exit_code in (0, 1)
                else:
                    results = self._search_fallback(pattern, path, max_results)
                    stdout = "\n".join(results)
                    exit_code = 0
                    ok = True
            elif name == "fs.read":
                full = self.guard.resolve(args.get("path"))
                if not os.path.isfile(full):
                    raise ToolError("fs.read path is not a file")
                max_lines = int(args.get("max_lines") or self.max_output_lines)
                max_lines = max(1, min(max_lines, self.max_output_lines))
                lines = []
                truncated = False
                with open(full, "r", encoding="utf-8", errors="ignore") as f:
                    for i, line in enumerate(f):
                        if i >= max_lines:
                            truncated = True
                            break
                        lines.append(line)
                stdout = "".join(lines)
                stdout, trunc2 = truncate_text(stdout, self.max_output_chars, max_lines)
                truncated = truncated or trunc2
                extra = {
                    "lines": len(lines),
                    "path": self.guard.relative(full),
                    "_truncated": truncated,
                }
            elif name == "fs.list":
                full = self.guard.resolve(args.get("path"))
                max_entries = int(args.get("max_entries") or 200)
                max_entries = max(1, min(max_entries, 1000))
                if os.path.isfile(full):
                    entries = [{"name": os.path.basename(full), "type": "file", "size": os.path.getsize(full)}]
                    truncated = False
                else:
                    names = sorted(os.listdir(full))
                    truncated = len(names) > max_entries
                    names = names[:max_entries]
                    entries = []
                    for n in names:
                        fp = os.path.join(full, n)
                        try:
                            st = os.lstat(fp)
                            if os.path.islink(fp):
                                typ = "symlink"
                            elif os.path.isdir(fp):
                                typ = "dir"
                            else:
                                typ = "file"
                            entries.append({"name": n, "type": typ, "size": st.st_size})
                        except Exception:
                            entries.append({"name": n, "type": "unknown", "size": 0})
                stdout = json.dumps(entries, indent=2, ensure_ascii=False)
                stdout, trunc2 = truncate_text(stdout, self.max_output_chars, self.max_output_lines)
                truncated = trunc2
                extra = {"entries": len(entries)}
            elif name == "fs.stat":
                full = self.guard.resolve(args.get("path"))
                st = os.stat(full)
                data = {
                    "path": self.guard.relative(full),
                    "size": st.st_size,
                    "is_file": os.path.isfile(full),
                    "is_dir": os.path.isdir(full),
                    "is_symlink": os.path.islink(full),
                    "mtime": st.st_mtime,
                }
                stdout = json.dumps(data, indent=2, ensure_ascii=False)
                exit_code = 0
            elif name == "shell.run_safe":
                command = args.get("command")
                if not command:
                    raise ToolError("shell.run_safe requires command")
                argv = admit_command(str(command), self.root)
                exit_code, stdout, stderr = self._run(argv, args.get("timeout"))
                ok = exit_code == 0
            elif name == "build.check":
                argv = ["cargo", "check"]
                if args.get("package"):
                    argv.extend(["--package", str(args["package"])])
                if args.get("features"):
                    features = args["features"]
                    if isinstance(features, list):
                        features = ",".join(str(x) for x in features)
                    argv.extend(["--features", str(features)])
                if args.get("no_default_features"):
                    argv.append("--no-default-features")
                command = " ".join(shlex.quote(a) for a in argv)
                admit_command(command, self.root)
                exit_code, stdout, stderr = self._run(argv, args.get("timeout"))
                ok = exit_code == 0
            elif name == "test.run":
                if args.get("command"):
                    command = str(args["command"])
                    argv = admit_command(command, self.root)
                else:
                    argv = ["cargo", "test"]
                    if args.get("package"):
                        argv.extend(["--package", str(args["package"])])
                    if args.get("test_name"):
                        argv.append(str(args["test_name"]))
                    command = " ".join(shlex.quote(a) for a in argv)
                    admit_command(command, self.root)
                exit_code, stdout, stderr = self._run(argv, args.get("timeout"))
                ok = exit_code == 0
            else:
                raise ToolError(f"unknown tool: {name}")
        except ToolError as e:
            exit_code = 1
            stderr = str(e)
            ok = False
        except Exception as e:
            exit_code = 1
            stderr = str(e)
            ok = False
        if extra and "_truncated" in extra:
            truncated = bool(extra.pop("_truncated"))

        elapsed_ms = int((time.monotonic() - start) * 1000)
        stdout, trunc_out = truncate_text(stdout, self.max_output_chars, self.max_output_lines)
        stderr, trunc_err = truncate_text(stderr, self.max_output_chars, self.max_output_lines)
        return make_observation(
            self.root,
            name,
            args,
            exit_code,
            stdout,
            stderr,
            elapsed_ms,
            trunc_out or trunc_err,
            ok,
            extra,
        )


class ModelClient:
    def __init__(
        self,
        api_base: str = DEFAULT_API_BASE,
        model: str = DEFAULT_MODEL,
        api_key: str = DEFAULT_API_KEY,
        timeout: float = 120.0,
        max_tokens: int = 2048,
        temperature: float = 0.0,
        debug: bool = False,
        opener: Any = None,
    ):
        self.api_base = api_base.rstrip("/")
        self.model = model
        self.api_key = api_key
        self.timeout = timeout
        self.max_tokens = max_tokens
        self.temperature = temperature
        self.debug = debug
        self.opener = opener or urllib.request.urlopen
        self.usage = {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}
        self._lock = threading.Lock()

    def _add_usage(self, usage: Any) -> None:
        if not isinstance(usage, dict):
            return
        with self._lock:
            for key in self.usage:
                try:
                    self.usage[key] += int(usage.get(key, 0) or 0)
                except Exception:
                    pass

    def chat(self, messages: List[Dict[str, str]]) -> Tuple[str, Dict[str, Any]]:
        payload = {
            "model": self.model,
            "messages": messages,
            "temperature": self.temperature,
            "max_tokens": self.max_tokens,
            "stream": False,
        }
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            self.api_base + "/chat/completions",
            data=data,
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {self.api_key}",
            },
            method="POST",
        )
        try:
            with self.opener(req, timeout=self.timeout) as resp:
                body = resp.read().decode("utf-8", errors="ignore")
        except (socket.timeout, TimeoutError) as e:
            raise ModelError("model request timed out") from e
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", errors="ignore")[:500]
            raise ModelError(f"model HTTP {e.code}: {detail}") from e
        except urllib.error.URLError as e:
            raise ModelError(f"model URL error: {e.reason}") from e
        except Exception as e:
            raise ModelError(f"model request failed: {e}") from e
        try:
            obj = json.loads(body)
            content = obj["choices"][0]["message"]["content"]
        except Exception as e:
            raise ModelError(f"invalid model response: {e}") from e
        if not isinstance(content, str):
            raise ModelError("model content missing or not a string")
        self._add_usage(obj.get("usage"))
        return content, obj.get("usage") or {}


def parse_json_protocol(content: str) -> Dict[str, Any]:
    if not isinstance(content, str):
        raise ProtocolError("model output must be a string")
    text = content.strip()
    if not text.startswith("{") or not text.endswith("}"):
        raise ProtocolError("model output must be a single JSON object")
    try:
        obj = json.loads(text)
    except json.JSONDecodeError as e:
        raise ProtocolError(f"invalid JSON: {e}") from e
    if not isinstance(obj, dict):
        raise ProtocolError("JSON root must be an object")
    t = obj.get("type")
    if t == "tool":
        name = obj.get("name")
        if not isinstance(name, str) or name not in ALL_TOOLS:
            raise ProtocolError("tool name invalid")
        args = obj.get("args", {})
        if not isinstance(args, dict):
            raise ProtocolError("tool args must be an object")
        return {"type": "tool", "name": name, "args": args}
    if t == "final":
        content_val = obj.get("content")
        if not isinstance(content_val, str):
            raise ProtocolError("final content must be a string")
        return {"type": "final", "content": content_val}
    if t == "spawn":
        role = obj.get("role")
        if role not in {"scout", "adversary"}:
            raise ProtocolError("spawn role must be scout or adversary")
        task = obj.get("task", "")
        if not isinstance(task, str):
            raise ProtocolError("spawn task must be a string")
        context = obj.get("context", {})
        if not isinstance(context, dict):
            raise ProtocolError("spawn context must be an object")
        return {"type": "spawn", "role": role, "task": task, "context": context}
    raise ProtocolError("type must be tool, final, or spawn")


def normalize_worker_output(role: str, content: Any) -> Dict[str, Any]:
    data: Dict[str, Any] = {}
    if isinstance(content, str):
        try:
            parsed = json.loads(content)
            if isinstance(parsed, dict):
                data = parsed
            else:
                data = {"claims": [content] if content else []}
        except Exception:
            data = {"claims": [content] if content else []}
    elif isinstance(content, dict):
        data = content

    def _as_list(value: Any) -> List[str]:
        if isinstance(value, str):
            return [value]
        if isinstance(value, list):
            return [str(x) for x in value]
        return []

    return {
        "role": role,
        "claims": _as_list(data.get("claims")),
        "evidence": _as_list(data.get("evidence")),
        "files": _as_list(data.get("files")),
        "commands": _as_list(data.get("commands")),
        "risks": _as_list(data.get("risks")),
        "next_actions": _as_list(data.get("next_actions")),
    }


class WorkerHandle:
    def __init__(self, role: str, future: Any):
        self.role = role
        self.future = future
        self.harvested = False


class Emitter:
    def __init__(self):
        self._lock = threading.Lock()

    def __call__(self, message: str) -> None:
        with self._lock:
            print(message, flush=True)


class Session:
    def __init__(
        self,
        role: str,
        task: str,
        client: ModelClient,
        executor: ToolExecutor,
        guard: RepositoryGuard,
        max_turns: int = 12,
        worker_max_turns: int = 8,
        context_budget: int = 32768,
        output_reserve: int = 2048,
        debug: bool = False,
        emit: Any = None,
        allowed_spawn_roles: Optional[set] = None,
        expected_worker_roles: Optional[set] = None,
    ):
        self.role = role
        self.task = task
        self.client = client
        self.executor = executor
        self.guard = guard
        self.max_turns = max_turns
        self.worker_max_turns = worker_max_turns
        self.context_budget = context_budget
        self.output_reserve = output_reserve
        self.debug = debug
        self.emit = emit or Emitter()
        self.allowed_spawn_roles = set(allowed_spawn_roles or set())
        self.expected_worker_roles = set(expected_worker_roles or set())
        self.received_worker_roles = set()
        self.spawned_roles = set()
        self.worker_handles: List[WorkerHandle] = []
        self.messages = [
            {"role": "system", "content": self._system_prompt()},
            {"role": "user", "content": task},
        ]
        self.stats = {
            "model_turns": 0,
            "tool_calls": 0,
            "protocol_errors": 0,
            "evidence": 0,
            "spawn_calls": 0,
        }
        self.call_counts: Dict[Tuple[str, str], int] = {}
        self.failed_calls: Dict[Tuple[str, str], int] = {}
        self.final_without_evidence_reminded = False
        self.final_pending_workers_reminded = False
        self.result: Optional[Dict[str, Any]] = None
        self.start_time = time.monotonic()

    def _system_prompt(self) -> str:
        tools = ALL_TOOLS if self.role == "parent" else READONLY_TOOLS
        hints = {
            "git.status": "args {}",
            "git.diff": "args {staged?: bool, path?: str}",
            "git.log": "args {count?: int, path?: str}",
            "repo.search": "args {pattern: str, path?: str, max_results?: int}",
            "fs.read": "args {path: str, max_lines?: int}",
            "fs.list": "args {path: str, max_entries?: int}",
            "fs.stat": "args {path: str}",
            "shell.run_safe": "args {command: str, timeout?: float}",
            "build.check": "args {package?: str, features?: list, no_default_features?: bool, timeout?: float}",
            "test.run": "args {command?: str, package?: str, test_name?: str, timeout?: float}",
        }
        tool_lines = [f"- {tool}: {hints.get(tool, 'args {}')}" for tool in sorted(tools)]
        spawn_line = ""
        if self.role == "parent" and self.allowed_spawn_roles:
            roles = "|".join(sorted(self.allowed_spawn_roles))
            spawn_line = f'SPAWN: {{"type":"spawn","role":"<{roles}>","task":"...","context":{{...}}}}\n'
        worker_final = ""
        if self.role != "parent":
            worker_final = (
                "FINAL content MUST be a JSON string with keys: "
                "role, claims, evidence, files, commands, risks, next_actions.\n"
            )
        return (
            f"You are HAIDER P0 {self.role}.\n"
            f"Project root: {self.guard.root}\n"
            f"Role: {self.role}\n"
            f"P0 invariant: MODELS THINK. TOOLS KNOW. OBSERVE BEFORE CLAIMING.\n"
            f"Respond ONLY with one JSON object. No markdown. No prose.\n"
            f"Allowed tools:\n" + "\n".join(tool_lines) + "\n"
            f"TOOL: {{\"type\":\"tool\",\"name\":\"<tool>\",\"args\":{{...}}}}\n"
            f"FINAL: {{\"type\":\"final\",\"content\":\"...\"}}\n"
            f"{spawn_line}"
            f"{worker_final}"
            f"Context budget: {self.context_budget} tokens; output reserve: {self.output_reserve} tokens.\n"
        )

    def _allowed_tool(self, name: str) -> bool:
        if self.role == "parent":
            return name in ALL_TOOLS
        return name in READONLY_TOOLS

    def _fit_messages(self) -> List[Dict[str, str]]:
        budget = max(1024, self.context_budget - self.output_reserve)

        def est(msgs: List[Dict[str, str]]) -> int:
            return sum(estimate_tokens(json.dumps(m, ensure_ascii=False)) for m in msgs)

        msgs = self.messages
        if est(msgs) <= budget:
            return msgs
        while len(msgs) > 3 and est(msgs) > budget:
            msgs.pop(2)
        for i in range(2, len(msgs)):
            if est(msgs) <= budget:
                break
            content = msgs[i].get("content", "")
            if len(content) > 200:
                msgs[i] = {
                    "role": msgs[i]["role"],
                    "content": content[:200] + "\n...[context-truncated]",
                }
        return msgs

    def _append_user(self, content: str) -> None:
        content, _ = truncate_text(content, 4000, 200)
        self.messages.append({"role": "user", "content": content})

    def _append_observation(self, obs: Dict[str, Any]) -> None:
        content = json.dumps(obs, ensure_ascii=False)
        content, _ = truncate_text(content, 4000, 200)
        self.messages.append({"role": "user", "content": f"OBSERVATION: {content}"})

    def _harvest_workers(self) -> None:
        for handle in self.worker_handles:
            if handle.harvested:
                continue
            if handle.future.done():
                handle.harvested = True
                try:
                    res = handle.future.result()
                except Exception as e:
                    res = {"role": handle.role, "final": f"worker failed: {e}", "ok": False}
                packet = normalize_worker_output(handle.role, res.get("final", ""))
                self.received_worker_roles.add(handle.role)
                elapsed_ms = int(res.get("elapsed_ms", 0) or (res.get("elapsed_s", 0) or 0) * 1000)
                obs = make_observation(
                    self.guard.root,
                    "worker_result",
                    {"role": handle.role},
                    0 if res.get("ok", True) else 1,
                    json.dumps(packet, ensure_ascii=False),
                    "",
                    elapsed_ms,
                    False,
                    res.get("ok", True),
                    {"result": packet},
                )
                self._append_observation(obs)

    def _wait_workers(self, timeout: float = 60.0) -> None:
        for handle in self.worker_handles:
            if not handle.future.done():
                try:
                    handle.future.result(timeout=timeout)
                except Exception:
                    pass
        self._harvest_workers()

    def _finish(self, ok: bool, final: str, label: Optional[str] = None) -> Dict[str, Any]:
        self.result = {
            "role": self.role,
            "final": final,
            "ok": bool(ok),
            "stats": self.stats,
            "elapsed_s": round(time.monotonic() - self.start_time, 3),
        }
        self.emit(label or ("✓ FINAL" if ok else "✗ STOP"))
        return self.result

    def run(self, worker_handles: Optional[List[WorkerHandle]] = None) -> Dict[str, Any]:
        self.worker_handles = worker_handles or []
        for _ in range(self.max_turns):
            self._harvest_workers()
            messages = self._fit_messages()
            self.emit(f"● {self.role.upper()}")
            try:
                content, _usage = self.client.chat(messages)
            except ModelError as e:
                self.stats["protocol_errors"] += 1
                self._append_user(f"PROTOCOL_ERROR: model request failed: {e}. Respond with one JSON object.")
                if self.stats["protocol_errors"] >= 3:
                    return self._finish(False, "Stopped after repeated model/protocol errors.")
                continue
            except Exception as e:
                self.stats["protocol_errors"] += 1
                self._append_user(f"PROTOCOL_ERROR: model request failed: {e}. Respond with one JSON object.")
                if self.stats["protocol_errors"] >= 3:
                    return self._finish(False, "Stopped after repeated model/protocol errors.")
                continue
            self.stats["model_turns"] += 1
            if self.debug:
                raw, _ = truncate_text(content, 2000, 50)
                self.emit(f"RAW {self.role.upper()} {raw}")
            try:
                action = parse_json_protocol(content)
            except ProtocolError as e:
                self.stats["protocol_errors"] += 1
                self._append_user(f"PROTOCOL_ERROR: {e}. Respond with one JSON object.")
                if self.stats["protocol_errors"] >= 3:
                    return self._finish(False, "Stopped after repeated protocol errors.")
                continue

            if action["type"] == "tool":
                name = action["name"]
                args = action["args"]
                if not self._allowed_tool(name):
                    self.stats["protocol_errors"] += 1
                    self._append_user(f"PROTOCOL_ERROR: tool {name} not allowed for {self.role}.")
                    if self.stats["protocol_errors"] >= 3:
                        return self._finish(False, "Stopped after repeated protocol errors.")
                    continue
                self.emit(f"→ TOOL {name}")
                obs = self.executor.execute(name, args)
                self.stats["tool_calls"] += 1
                self.stats["evidence"] += 1
                key = (name, json.dumps(args, sort_keys=True, ensure_ascii=False))
                self.call_counts[key] = self.call_counts.get(key, 0) + 1
                stop_reason = None
                if not obs["ok"]:
                    self.failed_calls[key] = self.failed_calls.get(key, 0) + 1
                    if self.failed_calls[key] >= 2:
                        self._append_user("WATCHDOG: same failed operation repeated. Use a different action or final.")
                        if self.failed_calls[key] >= 3:
                            stop_reason = f"Stopped after repeated failed {name}."
                else:
                    self.failed_calls.pop(key, None)
                if self.call_counts[key] >= 3:
                    self._append_user("WATCHDOG: identical call repeated. Change action.")
                    if self.call_counts[key] >= 4:
                        stop_reason = "Stopped after repeated identical calls."
                self.emit(f"← {'OK' if obs['ok'] else 'FAIL'} {obs['elapsed_ms']} ms")
                if name == "fs.read":
                    self.emit(f"← {obs.get('lines', 0)} lines")
                if name in {"build.check", "test.run"}:
                    self.emit(f"← exit={obs['exit_code']}")
                self._append_observation(obs)
                if stop_reason:
                    return self._finish(False, stop_reason)

            elif action["type"] == "spawn":
                if self.role != "parent":
                    self.stats["protocol_errors"] += 1
                    self._append_user("PROTOCOL_ERROR: only parent may spawn workers.")
                    if self.stats["protocol_errors"] >= 3:
                        return self._finish(False, "Stopped after repeated protocol errors.")
                    continue
                role = action["role"]
                if role not in self.allowed_spawn_roles:
                    self.stats["protocol_errors"] += 1
                    self._append_user(
                        f"PROTOCOL_ERROR: spawn role {role} not allowed. Allowed: {sorted(self.allowed_spawn_roles)}."
                    )
                    if self.stats["protocol_errors"] >= 3:
                        return self._finish(False, "Stopped after repeated protocol errors.")
                    continue
                if role in self.spawned_roles:
                    obs = make_observation(
                        self.guard.root,
                        "spawn",
                        {"role": role},
                        1,
                        "",
                        "worker already spawned",
                        0,
                        False,
                        False,
                    )
                    self._append_observation(obs)
                    continue
                self.spawned_roles.add(role)
                self.stats["spawn_calls"] += 1
                self.emit(f"→ SPAWN {role}")
                task = action.get("task") or DEFAULT_WORKER_TASKS.get(role, "Complete the worker task.")
                task = f"{task}\nParent task: {self.task}"
                if action.get("context"):
                    task += f"\nContext: {json.dumps(action['context'], ensure_ascii=False)}"
                worker = Session(
                    role,
                    task,
                    self.client,
                    self.executor,
                    self.guard,
                    max_turns=self.worker_max_turns,
                    worker_max_turns=self.worker_max_turns,
                    context_budget=self.context_budget,
                    output_reserve=self.output_reserve,
                    debug=self.debug,
                    emit=self.emit,
                    allowed_spawn_roles=set(),
                    expected_worker_roles=set(),
                )
                start = time.monotonic()
                worker_result = worker.run()
                elapsed = time.monotonic() - start
                packet = normalize_worker_output(role, worker_result.get("final", ""))
                self.received_worker_roles.add(role)
                self.emit(f"✓ WORKER {role} {elapsed:.1f}s")
                obs = make_observation(
                    self.guard.root,
                    "spawn",
                    {"role": role},
                    0 if worker_result.get("ok", True) else 1,
                    json.dumps(packet, ensure_ascii=False),
                    "",
                    int(elapsed * 1000),
                    False,
                    worker_result.get("ok", True),
                    {"result": packet},
                )
                self._append_observation(obs)

            elif action["type"] == "final":
                content_val = action["content"]
                if (
                    self.role == "parent"
                    and self.expected_worker_roles
                    and not self.expected_worker_roles.issubset(self.received_worker_roles)
                ):
                    self._wait_workers(timeout=60.0)
                    if not self.expected_worker_roles.issubset(self.received_worker_roles):
                        if not self.final_pending_workers_reminded:
                            self._append_user(
                                "WATCHDOG: worker results pending. Continue or final only if you can state uncertainty."
                            )
                            self.final_pending_workers_reminded = True
                            continue
                if self.stats["evidence"] == 0 and not self.final_without_evidence_reminded:
                    self._append_user(
                        "WATCHDOG: UNOBSERVED CLAIMS REQUIRE TOOLS. Request deterministic evidence before final, unless no tools are needed."
                    )
                    self.final_without_evidence_reminded = True
                    continue
                return self._finish(True, content_val)
        return self._finish(False, "Max turns reached.", "✗ MAX_TURNS")


def validate_lanes(n: int) -> int:
    if n not in (1, 2, 3):
        raise ValueError("--lanes must be 1, 2, or 3")
    return n


def run_forced_parallel(args: argparse.Namespace, guard: RepositoryGuard, executor: ToolExecutor, client: ModelClient, emit: Emitter) -> Dict[str, Any]:
    start = time.monotonic()
    emit("● FORCED_PARALLEL lanes=3")
    scout_session = Session(
        "scout",
        f"SCOUT: {args.task}\nUse read-only tools. Return final JSON findings.",
        client,
        executor,
        guard,
        max_turns=args.worker_max_turns,
        worker_max_turns=args.worker_max_turns,
        context_budget=args.context_budget,
        output_reserve=args.output_reserve,
        debug=args.debug,
        emit=emit,
    )
    adversary_session = Session(
        "adversary",
        f"ADVERSARY: {args.task}\nUse read-only tools. Return final JSON findings.",
        client,
        executor,
        guard,
        max_turns=args.worker_max_turns,
        worker_max_turns=args.worker_max_turns,
        context_budget=args.context_budget,
        output_reserve=args.output_reserve,
        debug=args.debug,
        emit=emit,
    )
    with ThreadPoolExecutor(max_workers=3) as ex:
        scout_handle = WorkerHandle("scout", ex.submit(scout_session.run))
        adversary_handle = WorkerHandle("adversary", ex.submit(adversary_session.run))
        parent_session = Session(
            "parent",
            args.task,
            client,
            executor,
            guard,
            max_turns=args.max_turns,
            worker_max_turns=args.worker_max_turns,
            context_budget=args.context_budget,
            output_reserve=args.output_reserve,
            debug=args.debug,
            emit=emit,
            allowed_spawn_roles=set(),
            expected_worker_roles={"scout", "adversary"},
        )
        parent_future = ex.submit(parent_session.run, [scout_handle, adversary_handle])
        parent_result = parent_future.result()
        scout_result = scout_handle.future.result()
        adversary_result = adversary_handle.future.result()
    total = time.monotonic() - start
    emit(f"✓ WORKER scout {scout_result.get('elapsed_s', 0):.1f}s")
    emit(f"✓ WORKER adversary {adversary_result.get('elapsed_s', 0):.1f}s")
    emit(f"✓ PARENT {parent_result.get('elapsed_s', 0):.1f}s")
    emit(f"✓ TOTAL {total:.1f}s")
    return {
        "parent": parent_result,
        "scout": scout_result,
        "adversary": adversary_result,
        "wall_time_s": round(total, 3),
        "usage": client.usage,
    }


def run_normal(args: argparse.Namespace, guard: RepositoryGuard, executor: ToolExecutor, client: ModelClient, emit: Emitter) -> Dict[str, Any]:
    lanes = validate_lanes(args.lanes)
    allowed = set()
    if lanes >= 2:
        allowed.add("scout")
    if lanes >= 3:
        allowed.add("adversary")
    parent = Session(
        "parent",
        args.task,
        client,
        executor,
        guard,
        max_turns=args.max_turns,
        worker_max_turns=args.worker_max_turns,
        context_budget=args.context_budget,
        output_reserve=args.output_reserve,
        debug=args.debug,
        emit=emit,
        allowed_spawn_roles=allowed,
    )
    result = parent.run()
    return {"parent": result, "usage": client.usage}


def build_arg_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="HAIDER P0 tool bridge")
    parser.add_argument("--task", required=True)
    parser.add_argument("--lanes", type=int, default=1)
    parser.add_argument("--force-parallel", action="store_true")
    parser.add_argument("--cwd", default=os.getcwd())
    parser.add_argument("--api-base", default=DEFAULT_API_BASE)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    parser.add_argument("--api-key", default=DEFAULT_API_KEY)
    parser.add_argument("--max-turns", type=int, default=16)
    parser.add_argument("--worker-max-turns", type=int, default=10)
    parser.add_argument("--timeout", type=float, default=30.0)
    parser.add_argument("--model-timeout", type=float, default=120.0)
    parser.add_argument("--context-budget", type=int, default=int(os.environ.get("HAIDER_CONTEXT_BUDGET", "32768")))
    parser.add_argument("--output-reserve", type=int, default=2048)
    parser.add_argument("--max-output-chars", type=int, default=12000)
    parser.add_argument("--debug", action="store_true")
    return parser


def main(argv: Optional[List[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    try:
        lanes = validate_lanes(args.lanes)
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        return 2
    if args.context_budget <= args.output_reserve:
        args.output_reserve = max(256, args.context_budget // 4)
    guard = RepositoryGuard.detect(args.cwd)
    executor = ToolExecutor(guard, max_output_chars=args.max_output_chars, timeout=args.timeout)
    client = ModelClient(
        api_base=args.api_base,
        model=args.model,
        api_key=args.api_key,
        timeout=args.model_timeout,
        max_tokens=args.output_reserve,
        debug=args.debug,
    )
    emit = Emitter()
    emit(f"● ROOT {guard.root}")
    emit(f"● MODEL {client.model}")
    emit(f"● LANES {lanes}")
    try:
        if args.force_parallel and lanes >= 3:
            result = run_forced_parallel(args, guard, executor, client, emit)
        else:
            result = run_normal(args, guard, executor, client, emit)
    except ModelError as e:
        emit(f"✗ MODEL {e}")
        return 1
    except Exception as e:
        emit(f"✗ ERROR {e}")
        return 1
    parent = result.get("parent") or {}
    final_text, _ = truncate_text(parent.get("final", ""), 4000, 200)
    emit(f"FINAL: {final_text}")
    usage = result.get("usage") or client.usage
    if usage.get("total_tokens"):
        emit(f"USAGE {json.dumps(usage)}")
    return 0 if parent.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
