{
  "canonical_home": {
    "codegen": "hawking-adapters-codegen (same golden/drift pattern as hide-sdk-codegen; not a second codegen system)",
    "crate": "crates/hawking-adapters",
    "family_modules": "crates/hawking-adapters/src/families/",
    "registry": "crates/hawking-adapters/src/registry.rs"
  },
  "fields": [
    {
      "description": "Canonical family id (stable string key)",
      "name": "family_id",
      "null_allowed": false,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Alternate ids / arch strings that resolve to this family",
      "name": "aliases",
      "null_allowed": false,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Source/config class identifiers",
      "name": "source_config_classes",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Tensor naming / packing rules",
      "name": "tensor_namespace_rules",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Tokenizer identity or protocol",
      "name": "tokenizer",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Chat template identity",
      "name": "chat_template",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Attention or recurrent state mechanism",
      "name": "attention_or_state",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Dense / MoE topology",
      "name": "topology",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Normalization class",
      "name": "normalization",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Positional encoding class",
      "name": "positional_encoding",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "KV cache or state format",
      "name": "kv_or_state_format",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Context limits and their validation status",
      "name": "context_limits",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Ingestible artifact codecs",
      "name": "artifact_codecs",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "CPU / Metal / CUDA provider availability",
      "name": "providers",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Fabric partition / placement boundaries",
      "name": "fabric_partition_boundaries",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Known capability limitations",
      "name": "capability_limitations",
      "null_allowed": false,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Source precision / quant classes",
      "name": "source_precision_classes",
      "null_allowed": true,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Named parity / grade evidence entries",
      "name": "parity_evidence",
      "null_allowed": false,
      "null_requires_reason": true,
      "required": true
    },
    {
      "description": "Honest support grade on the seven-step ladder",
      "name": "support_level",
      "null_allowed": false,
      "null_requires_reason": true,
      "required": true
    }
  ],
  "note": "One canonical adapter ABI. Families declare every field; generators emit matrices. No family is PRODUCTION today.",
  "promotion_rule": "Promotion requires the evidence the grade names. No family becomes PRODUCTION because its shapes look familiar.",
  "schema": "hawking.adapters.abi.v1",
  "support_grades": [
    {
      "grade": "DECLARED",
      "meaning": "described; nothing parsed, nothing executes",
      "required_evidence_kind": null
    },
    {
      "grade": "SOURCE_HEADER_VALIDATED",
      "meaning": "real official config/tokenizer/safetensors header parsed and mapped",
      "required_evidence_kind": "source_header"
    },
    {
      "grade": "SYNTHETIC_PARITY",
      "meaning": "matches a deterministic reference on a synthetic twin",
      "required_evidence_kind": "synthetic_parity"
    },
    {
      "grade": "REAL_TENSOR_DECODE",
      "meaning": "at least one real tensor decoded from a real checkpoint",
      "required_evidence_kind": "real_tensor_decode"
    },
    {
      "grade": "SMALL_REAL_CHECKPOINT",
      "meaning": "a real small checkpoint of the family runs end to end",
      "required_evidence_kind": "small_checkpoint_run"
    },
    {
      "grade": "FULL_PARENT_VALIDATED",
      "meaning": "a real full-size parent validated",
      "required_evidence_kind": "full_parent_validation"
    },
    {
      "grade": "PRODUCTION",
      "meaning": "served, under test, with a standing parity receipt",
      "required_evidence_kind": "production_receipt"
    }
  ],
  "title": "HawkingAdapterAbi"
}
