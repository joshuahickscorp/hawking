    "contributing_bugs_fixed": [
      {
        "evidence": "PAIRED_TENSOR_META teacher_pad.padded_zeros was 6080; after fix 0 via carry_hidden_last_token",
        "file": "lab/operators/frankenstein_bridge_train_real.py",
        "id": "teacher_zero_pad",
        "mechanism": "load_glm_layer_matrix only loaded */samples width=64; build_real_training_tensors zero-padded 6080 dims to 6144. L_latent compared full student residuals to a nearly all-zero teacher under RMSNorm. Fix: prefer carry last-token / */mean full 6144 (real capture already has these)."
      },
      {
        "file": "lab/operators/frankenstein_latent_v0.py:apply_interventions",
        "id": "cascade_vs_parallel_residuals",
        "mechanism": "Eight nonlinear sites were composed sequentially on one proxy tensor, violating per-site y=x+A(x) transplant semantics and matching prior expansive-residual / accumulated-drift findings. Fix: parallel sum y = x + sum_i A_i(x)."
      },
      {
        "file": "lab/operators/frankenstein_latent_v0.py:_set_trainable_for_phase",
        "id": "phase_c_projector_freeze",
        "mechanism": "Phase C froze teacher_projector/student_observer while interventions moved adapted_hidden; phase E then reweighted L_latent=1.0 and joint-trained, causing L_latent explosions (e.g. C arm 2.93\u219224.48). Fix: keep projectors trainable in phase C."
      },
      {
        "file": "lab/operators/frankenstein_latent_v0.py:LatentV0Stack",
        "id": "expansive_gate_init",
        "mechanism": "gate_init 0 \u2192 residual_scale\u22480.173 per site; now gate_init=-2 \u2192 \u22480.032."
      },
      {
        "file": "lab/operators/frankenstein_latent_v0.py:train_schedule",
        "id": "final_eval_last_epoch",
        "mechanism": "final_eval_loss used last epoch CURRENT, often after phase-E regression. Now reloads BEST_BALANCED and re-evals under phase-E weights."
      }
    ],
    "not_a_gate_formula_bug": "complete_beats_linear compares the same final_eval_loss field. B legitimately omits L_latent because it has no latent modules; G must drive L_latent\u22480 to win. That is the intended complete-vs-linear test, not a mis-scale of objectives.",
    "primary": "G_COMPLETE_V0 final_eval_loss is dominated by L_latent (shared-space MSE). B_LINEAR_SUBSPACE_INITIALIZATION has no teacher/student projectors, so L_latent is absent from its loss and final_eval_loss stays ~0.01\u20130.10. Across original and fixed retrains, G never drives L_latent near zero (best mid-train ~2.6; terminal still multi-unit), so complete_v0_beats_linear_init stays False.",
