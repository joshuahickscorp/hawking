{
 "schema": "hawking.odyssey.gravity_attack.v2",
 "_label": "G021 / S009. A real Gravity attack on Qwen3-0.6B: 28 configurations across four materially different representation classes, complete EBPW accounting, mandatory destructive negative control, and an HONEST NEGATIVE VERDICT. Failures preserved, not filtered.",
 "_evidence": "MEASURED on CPU in fp32 math. Zero GPU, so the HCLI resident was never interrupted -- this entire attack ran alongside the live selfdev campaign.",
 "patient": "Qwen/Qwen3-0.6B (0.596B logical params; embedding 26.1%, attention 29.6%, mlp 44.3% of linear-weight mass)",
 "VERIFIER_ADEQUACY_ESTABLISHED_FIRST": {
  "why": "a prior campaign here built its adequacy gate on cosine similarity, which is scale-invariant, so a 0.01xW destroyed body scored 1.000000 on every axis and every number that campaign produced was void. The control is therefore run BEFORE any codec result is believed.",
  "fp32_baseline": {
   "perplexity": 59.6218,
   "top1_agreement_vs_fp32": 1.0,
   "kl_from_fp32": 0.0
  },
  "negative_control_0.01xW": {
   "perplexity": 152006.3869,
   "top1_agreement_vs_fp32": 0.0,
   "kl_from_fp32": 4753.57959
  },
  "verdict": "REJECTED DECISIVELY -- perplexity 59.62 -> 152006.39 (2550x), top-1 agreement 1.000 -> 0.000, KL 0 -> 4753.58. Every metric used is magnitude-sensitive by construction.",
  "restore_check": "restoring the baseline returns perplexity to 59.6218 and top-1 to exactly 1.0, so the harness itself introduces no drift between attempts."
 },
 "CEILING_CHECK_the_harness_is_not_the_defect": {
  "why": "a rejection is only earned if a GENEROUS codec is near-lossless. Otherwise the fault is the bench, not the body, and the verdict would be unearned.",
  "result": "grouped affine at 8 bits reaches top-1 0.9804 and perplexity 0.995x fp32. The codecs work; the collapse at low bit-width is the body.",
