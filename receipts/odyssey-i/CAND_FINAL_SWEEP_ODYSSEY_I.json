 "n_measured": 14,
 "n_unmeasurable": 2,
 "WHY_THE_LARGE_TIER_WAS_NEVER_ACTUALLY_BLOCKED": {
  "finding": "the frontier-scale bodies sat in the census-only pile for the whole campaign as though their size gated them. It never did: only GPU work was gated. A safetensors header is a length prefix plus a JSON blob at the head of each shard, so Kimi-K3 at 1.45TB yields exact per-tensor shapes and dtypes for the same cost as a 3GB body. The gate was assumed, not measured -- which is the same class of error as the fs.read window and the Mistral double-count found this session."
 },
 "SUB_BF16_NATIVE_STORAGE": {
  "bodies_below_1.8_bytes_per_param": {
   "moonshotai--Kimi-K3": 1.038,
   "zai-org--GLM-5.3-Flash": 1.022,
   "deepseek-ai--DeepSeek-V4-Flash": 1.01
  },
  "why_it_matters": "effective bytes-per-parameter computed from real tensor dtypes is the honest denominator for the Byte Elimination Law. Any body already shipping below 2 bytes/param is quantised at rest by its author, so Hawking's EBPW ladder starts from a different place there than on a BF16 body -- and comparing a Gravity result against a naive fp16 baseline would overstate the win."
 },
 "duplicate_export_check": {
  "specimens_shipping_both_a_consolidated_copy_and_shards": [
   "thinkingmachines--Inkling-Small"
  ],
  "note": "carried forward from the Mistral-Small-3.1-24B trap: shards are preferred and a consolidated sibling is never added to the same total."
 },
 "obvious_representation_opportunities": [
  "The MoE bodies in this sweep are the natural continuation of the O005/O006 expert-organ line at much larger scale -- their active fractions are recorded above and are what decides whether a gather lever pays.",
  "Bodies already below 2 bytes/param need their EBPW baseline set from their real dtype mix, not from an assumed fp16 parent."
 ],
