+        if qwen38_recon_fuse_enabled() {
+            let launch = gate.expect("affine geo");
+            assert_eq!(launch.1, grid);
+            assert_eq!(launch.2, tg);
+        }
+        crate::metal::assert_tpr64_tg128_threadgroup(
+            "qwen_affine_q2_group32_matvec_geo_tpr64_tg128",
