+/// Production geo_tpr64 occupancy class. Tuned on Q80 512×2048 organs;
+/// this body's K in {5120, 6144, 17408} is a multiple of the 512-col
+/// stride, so the same map covers every column with zero tail.
+pub const QWEN38_GEO_TPR64_THREADS_PER_ROW: u32 = 64;
+pub const QWEN38_GEO_TPR64_THREADGROUP: u32 = 128;
+pub const QWEN38_GEO_TPR64_ROWS_PER_TG: u32 = 2;
+pub const QWEN38_GEO_TPR64_COL_TILE: u32 = 8;
+pub const QWEN38_GEO_TPR64_COL_STRIDE: u32 = 512;
+/// Not a hardware occupancy counter. Same 60-core figure the token-ns
+/// ledger occupancy note uses.
+pub const QWEN38_GEO_TPR64_GPU_CORES: u32 = 60;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GeoTpr64ColumnCoverage {
+    pub cols: u32,
+    pub trips: u32,
+    pub idle_lanes_last_trip: u32,
+    pub dropped: u32,
+}
+
+/// Columns owned by the tpr64 map: lane `t` holds `[8t, 8t+8)` then +512.
+/// Exact cover iff `dropped == 0`. Production K values are exact.
+pub fn qwen38_geo_tpr64_column_coverage(cols: u32) -> GeoTpr64ColumnCoverage {
+    let tile = QWEN38_GEO_TPR64_COL_TILE;
+    let stride = QWEN38_GEO_TPR64_COL_STRIDE;
+    let tpr = QWEN38_GEO_TPR64_THREADS_PER_ROW;
+    let mut covered = 0u32;
+    for lane in 0..tpr {
+        let mut col = lane.saturating_mul(tile);
+        while col.saturating_add(tile) <= cols {
+            covered = covered.saturating_add(tile);
+            col = col.saturating_add(stride);
+        }
+    }
+    let trips = if cols >= tile {
+        (cols - tile) / stride + 1
+    } else {
+        0
+    };
+    let rem = cols % stride;
+    let idle_lanes_last_trip = if rem == 0 { 0 } else { tpr - rem / tile };
+    GeoTpr64ColumnCoverage {
+        cols,
+        trips,
+        idle_lanes_last_trip,
+        dropped: cols.saturating_sub(covered),
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GeoTpr64Occupancy {
+    pub rows: u32,
+    pub threadgroups: u32,
+    pub threads: u32,
+    pub gpu_cores: u32,
+    pub threadgroups_per_core: f64,
+}
+
+/// Launch occupancy derived from rows, not a GPU occupancy counter.
+pub fn qwen38_geo_tpr64_occupancy(rows: u32) -> GeoTpr64Occupancy {
+    let tg = QWEN38_GEO_TPR64_THREADGROUP;
+    let threadgroups = rows.div_ceil(QWEN38_GEO_TPR64_ROWS_PER_TG).max(1);
+    let threads = threadgroups.saturating_mul(tg);
+    let cores = QWEN38_GEO_TPR64_GPU_CORES;
+    GeoTpr64Occupancy {
+        rows,
+        threadgroups,
+        threads,
+        gpu_cores: cores,
+        threadgroups_per_core: threadgroups as f64 / f64::from(cores),
+    }
+}
+
+pub fn qwen38_geo_tpr64_grid_tg(rows: u32) -> ((u32, u32, u32), (u32, u32, u32)) {
+    let tg = QWEN38_GEO_TPR64_THREADGROUP;
+    let grid = rows
+        .div_ceil(QWEN38_GEO_TPR64_ROWS_PER_TG)
+        .saturating_mul(tg)
+        .max(tg);
+    ((grid, 1, 1), (tg, 1, 1))
+}
