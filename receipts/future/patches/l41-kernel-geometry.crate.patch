+#[cfg(test)]
+mod geo_tpr64_this_body_tests {
+    use super::*;
+
+    #[test]
+    fn production_k_has_zero_dropped_columns() {
+        for cols in [5120u32, 6144, 17408] {
+            let c = qwen38_geo_tpr64_column_coverage(cols);
+            assert_eq!(c.dropped, 0, "cols={cols}");
+            assert_eq!(c.idle_lanes_last_trip, 0, "cols={cols}");
+            assert_eq!(c.trips * QWEN38_GEO_TPR64_COL_STRIDE, cols, "cols={cols}");
+            assert_eq!(cols % K_COMPLETE_TILE_COLS, 0, "256-col tile cols={cols}");
+        }
+    }
+
+    #[test]
+    fn a_non_multiple_of_eight_drops_a_remainder() {
+        let c = qwen38_geo_tpr64_column_coverage(160);
+        assert_eq!(c.dropped, 0, "160 is 8-aligned so it still covers");
+        assert_eq!(c.idle_lanes_last_trip, 44);
+        let tail = qwen38_geo_tpr64_column_coverage(7);
+        assert_eq!(tail.dropped, 7);
+        assert_eq!(tail.trips, 0);
+    }
+
+    #[test]
+    fn production_organs_census_is_401_and_ba_is_the_only_starved() {
+        let organs = qwen38_production_gemv_organs();
+        let total: u32 = organs.iter().map(|o| o.count).sum();
+        assert_eq!(total, 401);
+        let affine: u32 = organs
+            .iter()
+            .filter(|o| o.kernel_class == "affine2")
+            .map(|o| o.count)
+            .sum();
+        let q4: u32 = organs
+            .iter()
+            .filter(|o| o.kernel_class == "q4")
+            .map(|o| o.count)
+            .sum();
+        assert_eq!(affine, 192);
+        assert_eq!(q4, 209);
+        let mut starved = Vec::new();
+        for organ in &organs {
+            let occ = qwen38_geo_tpr64_occupancy(organ.rows);
+            let cover = qwen38_geo_tpr64_column_coverage(organ.cols);
+            assert_eq!(cover.dropped, 0, "{}", organ.role);
+            if occ.threadgroups_per_core < 1.0 {
+                starved.push(organ.role);
+            }
+        }
+        assert_eq!(starved, ["linear_attn.in_proj_ba"]);
+        let ba = organs.iter().find(|o| o.role == "linear_attn.in_proj_ba").unwrap();
+        let occ = qwen38_geo_tpr64_occupancy(ba.rows);
+        assert_eq!(occ.threadgroups, 48);
+        assert_eq!(occ.gpu_cores, 60);
+    }
+
+    #[test]
+    fn launch_grid_matches_occupancy_class() {
+        let (grid, tg) = qwen38_geo_tpr64_grid_tg(17408);
