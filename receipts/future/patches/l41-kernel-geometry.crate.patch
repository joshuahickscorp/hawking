+/// `*_tpr64_tg128` kernels size `threadgroup float red[4]` for 4 simdgroups
+/// (TG 128). A wider threadgroup overruns that scratch (`simd_id` 4..7 at
+/// TG 256) and is a silent memory smash, not a geometry lever.
+pub fn assert_tpr64_tg128_threadgroup(fn_name: &str, tg: (u32, u32, u32)) -> Result<()> {
+    if fn_name.contains("tpr64_tg128") && tg != (128, 1, 1) {
+        return Err(Error::Metal(format!(
+            "kernel `{fn_name}` is the tpr64/tg128 occupancy class but threadgroup is {tg:?}; \
+             the shader's red[4] scratch is 4 simdgroups. Refusing rather than overflowing."
+        )));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tpr64_tg128_threadgroup_guard_tests {
+    use super::assert_tpr64_tg128_threadgroup;
+
+    #[test]
+    fn tg128_is_ok() {
+        assert!(assert_tpr64_tg128_threadgroup(
+            "qwen_q2f_group64_matvec_geo_tpr64_tg128",
+            (128, 1, 1)
+        )
+        .is_ok());
+        assert!(assert_tpr64_tg128_threadgroup(
+            "qwen_uniform_q4_group64_matvec_geo_tpr64_tg128_addr_probe",
+            (128, 1, 1)
+        )
+        .is_ok());
+    }
+
+    #[test]
+    fn tg256_is_refused() {
+        let err = assert_tpr64_tg128_threadgroup(
+            "qwen_q2f_group64_matvec_geo_tpr64_tg128",
+            (256, 1, 1),
+        )
+        .expect_err("TG 256 must refuse");
+        let msg = err.to_string();
+        assert!(msg.contains("tpr64/tg128"), "{msg}");
+        assert!(msg.contains("256"), "{msg}");
+    }
+
+    #[test]
+    fn other_kernels_keep_their_own_threadgroup() {
+        assert!(assert_tpr64_tg128_threadgroup(
+            "qwen_affine_q2_group64_matvec_tgx_r8tg256",
+            (256, 1, 1)
+        )
+        .is_ok());
+        assert!(assert_tpr64_tg128_threadgroup(
+            "qwen_affine_q2_group64_matvec_qmvfast_r8tg64",
+            (64, 1, 1)
+        )
+        .is_ok());
+    }
+}
