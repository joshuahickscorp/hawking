+/// Power-of-two threadgroup env used by RMSNorm / rope / DN gated-RMS.
+/// `0` selects the scalar one-thread-per-head form. Unset uses `default`.
+/// Parsed once at session attach; the token loop must not call `getenv`.
+pub fn qwen38_parse_threadgroup_env(name: &str, default: u32) -> u32 {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse::<u32>().ok())
+        .filter(|v| *v == 0 || (v.is_power_of_two() && (32..=1024).contains(v)))
+        .unwrap_or(default)
+}
+
+/// `groups_per_row` the production encode path actually binds.
+/// Group-128 uses truncating `/ 128` because that bind already requires
+/// `cols % 128 == 0`. Every other tensor uses `div_ceil(64)` — the
+/// uniform-Q4 group — even if the header's group_size differs.
+pub fn q4_groups_per_row(cols: usize, group_size: usize) -> u32 {
+    if group_size == UNIFORM_Q4_GROUP_SIZE_128 {
+        (cols / UNIFORM_Q4_GROUP_SIZE_128) as u32
+    } else {
+        cols.div_ceil(UNIFORM_Q4_GROUP_SIZE) as u32
+    }
+}
