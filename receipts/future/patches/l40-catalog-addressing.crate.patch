+#[cfg(test)]
+mod catalog_addressing_hoist_tests {
+    use super::*;
+
+    #[test]
+    fn q4_groups_per_row_matches_the_production_bind_formulas() {
+        assert_eq!(q4_groups_per_row(5_120, UNIFORM_Q4_GROUP_SIZE), 80);
+        assert_eq!(
+            q4_groups_per_row(5_120, UNIFORM_Q4_GROUP_SIZE),
+            5_120usize.div_ceil(UNIFORM_Q4_GROUP_SIZE) as u32
+        );
+        assert_eq!(
+            q4_groups_per_row(5_120, UNIFORM_Q4_GROUP_SIZE_128),
+            (5_120 / UNIFORM_Q4_GROUP_SIZE_128) as u32
+        );
+        assert_eq!(q4_groups_per_row(6_144, UNIFORM_Q4_GROUP_SIZE), 96);
+        // Non-64 header still binds div_ceil(64), matching the encode path
+        // before this hoist. Do not switch this to header.group_size.
+        assert_eq!(q4_groups_per_row(5_120, 32), 80);
+    }
+
+    #[test]
+    fn threadgroup_env_is_parsed_once_the_same_way_the_token_loop_used_to() {
+        const K: &str = "HAWKING_RMSNORM_TG";
+        let restore = std::env::var(K).ok();
+        std::env::remove_var(K);
+        assert_eq!(qwen38_parse_threadgroup_env(K, 1024), 1024);
+        std::env::set_var(K, "256");
+        assert_eq!(qwen38_parse_threadgroup_env(K, 1024), 256);
+        std::env::set_var(K, "0");
+        assert_eq!(qwen38_parse_threadgroup_env(K, 1024), 0);
+        std::env::set_var(K, "12");
+        assert_eq!(qwen38_parse_threadgroup_env(K, 1024), 1024);
+        std::env::set_var(K, "2048");
+        assert_eq!(qwen38_parse_threadgroup_env(K, 1024), 1024);
+        match restore {
+            Some(v) => std::env::set_var(K, v),
+            None => std::env::remove_var(K),
+        }
+    }
+
+    #[test]
+    fn serial_token_encoder_stays_off_unless_explicitly_enabled() {
+        const K: &str = "HAWKING_QWEN38_SERIAL_TOKEN_ENCODER";
+        let restore = std::env::var(K).ok();
+        std::env::remove_var(K);
+        assert!(!qwen38_serial_token_encoder_enabled());
+        std::env::set_var(K, "1");
+        assert!(qwen38_serial_token_encoder_enabled());
+        std::env::set_var(K, "0");
+        assert!(!qwen38_serial_token_encoder_enabled());
+        match restore {
+            Some(v) => std::env::set_var(K, v),
+            None => std::env::remove_var(K),
+        }
+    }
+}
