+    #[test]
+    fn region_timing_is_off_unless_explicit_one() {
+        const K: &str = "HAWKING_QWEN38_REGION_TIMING";
+        let restore = std::env::var(K).ok();
+        std::env::remove_var(K);
+        assert!(
+            !qwen38_region_timing_enabled(),
+            "unset must leave production uninstrumented"
+        );
+        std::env::set_var(K, "0");
+        assert!(!qwen38_region_timing_enabled());
+        std::env::set_var(K, "true");
+        assert!(
+            !qwen38_region_timing_enabled(),
+            "env_on is the =1 convention; true must not silently enable"
+        );
+        std::env::set_var(K, "1");
+        assert!(qwen38_region_timing_enabled());
+        if let Some(v) = restore {
+            std::env::set_var(K, v);
+        } else {
+            std::env::remove_var(K);
+        }
+    }
