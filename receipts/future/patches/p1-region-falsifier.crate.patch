+                catalog_bytes: QWEN38_MLP_LAYER_CATALOG_BYTES,
+                production,
+                contiguous,
+                max_abs_diff,
+                max_abs_diff_gate,
+                max_abs_diff_up,
+                max_abs_diff_act,
+                bit_identical,
+                subfactors_changed: &[
