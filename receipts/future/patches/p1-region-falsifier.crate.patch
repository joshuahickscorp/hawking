+            let up_p = self.read_f32_workspace("up", n_mid)?;
+            let act_p = self.read_f32_workspace("act", n_mid)?;
+            let down_p = self.read_f32_workspace("down", n_hidden)?;
+
+            let cont_parity = self.timed_cb(|tcb| self.encode_mlp_layer_contiguous(tcb, &packed))?;
+            let gate_c = self.read_f32_workspace("gate", n_mid)?;
+            let up_c = self.read_f32_workspace("up", n_mid)?;
+            let act_c = self.read_f32_workspace("act", n_mid)?;
+            let down_c = self.read_f32_workspace("down", n_hidden)?;
+
+            let max_abs_diff_gate = Self::max_abs_diff(&gate_p, &gate_c);
+            let max_abs_diff_up = Self::max_abs_diff(&up_p, &up_c);
