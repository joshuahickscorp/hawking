+
+        /// One representative MLP layer: production scattered tensors vs the
+        /// same arithmetic from one contiguous staging buffer in one serial
+        /// compute region. Does not mutate fusion flags or the decode graph.
+        pub fn measure_mlp_region_falsifier(
+            &self,
+            layer: usize,
+            warmup: usize,
+            reps: usize,
+        ) -> Result<Qwen38MlpRegionFalsifier> {
+            if layer >= QWEN38_LAYERS {
+                return Err(mixed_error(format!(
+                    "mlp region falsifier layer {layer} is out of range"
+                )));
+            }
+            if reps == 0 {
+                return Err(mixed_error("mlp region falsifier --reps must be > 0"));
+            }
+            let n_hidden = QWEN38_HIDDEN;
+            let n_mid = QWEN38_INTERMEDIATE;
+            let mut x = vec![0.0f32; n_hidden];
+            for (i, v) in x.iter_mut().enumerate() {
+                *v = ((i % 17) as f32) * 0.01 - 0.08;
+            }
