+
+        fn sample_packed_launch(
+            &self,
+            packed: &PackedAffineRowStack,
+            rows: u32,
+            warmup: usize,
+            reps: usize,
+            label: &str,
+        ) -> Result<(Vec<u64>, CommandBufferTiming)> {
+            for _ in 0..warmup {
+                let _ = self.timed_cb(|tcb| self.encode_packed_one_dispatch(tcb, packed, rows))?;
+            }
+            let mut ns = Vec::with_capacity(reps);
+            let mut last = CommandBufferTiming::default();
+            for _ in 0..reps {
+                last = self.timed_cb(|tcb| self.encode_packed_one_dispatch(tcb, packed, rows))?;
+                ns.push(Self::require_gpu_ns(&last, label)?);
+            }
+            Ok((ns, last))
+        }
+
+        /// Sweep effective GB/s against bytes per dispatch on one affine2
+        /// kernel. Concatenates real `mlp.gate_proj` catalog rows; does not
+        /// mutate fusion flags or the decode graph.
+        pub fn measure_dispatch_size_sweep(
+            &self,
+            warmup: usize,
+            reps: usize,
+        ) -> Result<Qwen38DispatchSizeSweep> {
+            if reps < 9 {
+                return Err(mixed_error(
+                    "dispatch size sweep --reps must be >= 9 (median over warmup-excluded samples)",
+                ));
+            }
+            let mut sources: Vec<&GpuAffine> = Vec::with_capacity(QWEN38_LAYERS);
+            for layer in 0..QWEN38_LAYERS {
+                let name = qwen38_layer_name(layer, "mlp.gate_proj.weight");
+                let body = self.affine(&name).ok_or_else(|| {
+                    mixed_error(format!("dispatch size sweep missing affine {name}"))
+                })?;
+                sources.push(body);
+            }
+            let proto = sources[0];
+            let (cpr, spr, bpr) = Self::affine_row_layout(proto)?;
+            let bytes_per_row = cpr + spr + bpr;
+            let unit_rows = proto.rows;
+            let unit_weight_bytes = bytes_per_row * unit_rows as u64;
+            let available_rows: u32 = sources.iter().map(|b| b.rows).sum();
+
+            let mut want_rows: Vec<u32> = Vec::new();
+            for &mb in &QWEN38_DISPATCH_SIZE_TARGETS_MB {
+                let target_bytes = (mb * 1e6).round() as u64;
+                let mut rows = (target_bytes / bytes_per_row) as u32;
+                if rows % 2 == 1 {
+                    rows = rows.saturating_sub(1);
+                }
+                rows = rows.max(2).min(available_rows);
+                if !want_rows.contains(&rows) {
+                    want_rows.push(rows);
+                }
+            }
+            if want_rows.len() < 5 {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep produced {} distinct row counts; need >= 5",
+                    want_rows.len()
+                )));
+            }
+            let max_rows = *want_rows.iter().max().unwrap_or(&2);
+            eprintln!(
+                "dispatch_size_sweep packing {max_rows} rows ({} MB) from mlp.gate_proj \
+                 unit_rows={unit_rows} bytes/row={bytes_per_row}",
+                max_rows as f64 * bytes_per_row as f64 / 1e6
+            );
+            let packed = self.pack_affine_row_stack(&sources, max_rows)?;
+
+            let n_hidden = QWEN38_HIDDEN;
+            if packed.cols as usize != n_hidden {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep: cols {} != hidden {n_hidden}",
+                    packed.cols
+                )));
+            }
+            let mut x = vec![0.0f32; n_hidden];
+            for (i, v) in x.iter_mut().enumerate() {
+                *v = ((i % 17) as f32) * 0.01 - 0.08;
+            }
+            self.write_f32_workspace("normalized", &x)?;
+
+            // Packed unit tensor vs production layer-0 gate_proj. If this
+            // drifts, the concatenated launches are not the same arithmetic.
+            zero_buffer(&packed.output);
+            let prod_body = sources[0];
+            let _ = self.timed_cb(|tcb| {
+                self.dispatch_affine(
+                    tcb,
+                    prod_body,
+                    &self.workspace.normalized,
+                    &self.workspace.gate,
+                )
+            })?;
+            let gate_p = self.read_f32_workspace("gate", unit_rows as usize)?;
+            zero_buffer(&packed.output);
+            let _ = self.timed_cb(|tcb| {
+                self.encode_packed_one_dispatch(tcb, &packed, unit_rows)
+            })?;
+            let packed_unit = {
+                let n = unit_rows as usize;
+                let mut out = vec![0.0f32; n];
+                unsafe {
+                    std::ptr::copy_nonoverlapping(
+                        packed.output.contents() as *const f32,
+                        out.as_mut_ptr(),
+                        n,
+                    );
+                }
+                out
+            };
+            let pack_parity_max_abs_diff = Self::max_abs_diff(&gate_p, &packed_unit);
+            let pack_parity_bit_identical = pack_parity_max_abs_diff == 0.0;
+            if !pack_parity_bit_identical {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep: packed unit tensor is not bit-identical \
+                     to production gate_proj (max_abs_diff={pack_parity_max_abs_diff})"
+                )));
+            }
+
+            let mut curve = Vec::with_capacity(want_rows.len());
+            for &rows in &want_rows {
+                let weight_bytes = bytes_per_row * rows as u64;
+                let target_mb = weight_bytes as f64 / 1e6;
+                let n_src = rows.div_ceil(unit_rows) as usize;
+                eprintln!(
+                    "  launch rows={rows} ({:.1} MB) warmup={warmup} reps={reps}",
+                    target_mb
+                );
+                let (samples, meta) = self.sample_packed_launch(
+                    &packed,
+                    rows,
+                    warmup,
+                    reps,
+                    "dispatch size sweep",
+                )?;
+                let point = Self::dispatch_size_point(
+                    format!("rows_{rows}"),
+                    target_mb,
+                    weight_bytes,
+                    rows,
+                    packed.cols,
+                    n_src,
+                    &samples,
+                    meta.dispatches,
+                    meta.encoder_count,
+                    meta.command_buffers,
+                )?;
+                eprintln!(
+                    "    {:.1} GB/s  {} ns  {} disp  {} enc",
+                    point.effective_gb_s,
+                    point.gpu_ns_median,
+                    point.dispatches,
+                    point.encoders
+                );
+                curve.push(point);
+            }
+
+            // Size-vs-shape control: same bytes, one tall GEMV vs N unit GEMVs.
+            let n_unit = {
+                let target = (337.7e6 / unit_weight_bytes as f64).round() as usize;
+                target.max(2).min((max_rows / unit_rows) as usize).max(2)
+            };
+            let control_rows = n_unit as u32 * unit_rows;
+            if control_rows > packed.rows {
+                return Err(mixed_error(
+                    "dispatch size sweep: control rows exceed packed staging",
+                ));
+            }
+            let control_bytes = bytes_per_row * control_rows as u64;
+            eprintln!(
+                "  control n_unit={n_unit} rows={control_rows} ({:.1} MB)",
+                control_bytes as f64 / 1e6
+            );
+            let (one_samples, one_meta) = self.sample_packed_launch(
+                &packed,
+                control_rows,
+                warmup,
+                reps,
+                "control one_large",
+            )?;
+            let one_large = Self::dispatch_size_point(
+                "one_large".to_owned(),
+                control_bytes as f64 / 1e6,
+                control_bytes,
+                control_rows,
+                packed.cols,
+                n_unit,
+                &one_samples,
+                one_meta.dispatches,
+                one_meta.encoder_count,
+                one_meta.command_buffers,
+            )?;
+            let mut one_out = vec![0.0f32; control_rows as usize];
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    packed.output.contents() as *const f32,
+                    one_out.as_mut_ptr(),
+                    control_rows as usize,
+                );
+            }
+            zero_buffer(&packed.output);
+            for _ in 0..warmup {
+                let _ = self.timed_cb(|tcb| {
+                    self.encode_packed_many_small(tcb, &packed, n_unit)
+                })?;
+            }
+            let mut many_ns = Vec::with_capacity(reps);
+            let mut many_meta = CommandBufferTiming::default();
+            for _ in 0..reps {
+                many_meta = self.timed_cb(|tcb| {
+                    self.encode_packed_many_small(tcb, &packed, n_unit)
+                })?;
+                many_ns.push(Self::require_gpu_ns(&many_meta, "control many_small")?);
+            }
+            let many_small = Self::dispatch_size_point(
+                "many_small".to_owned(),
+                control_bytes as f64 / 1e6,
+                control_bytes,
+                control_rows,
+                packed.cols,
+                n_unit,
+                &many_ns,
+                many_meta.dispatches,
+                many_meta.encoder_count,
+                many_meta.command_buffers,
+            )?;
+            let mut many_out = vec![0.0f32; control_rows as usize];
+            unsafe {
+                std::ptr::copy_nonoverlapping(
+                    packed.output.contents() as *const f32,
+                    many_out.as_mut_ptr(),
+                    control_rows as usize,
+                );
+            }
+            let control_diff = Self::max_abs_diff(&one_out, &many_out);
+            let control = Qwen38DispatchSizeControl {
+                total_weight_bytes: control_bytes,
+                n_unit_tensors: n_unit,
+                unit_rows,
+                one_large,
+                many_small,
+                max_abs_diff: control_diff,
+                bit_identical: control_diff == 0.0,
+            };
+            eprintln!(
+                "    one_large {:.1} GB/s  many_small {:.1} GB/s  max_abs_diff={control_diff}",
+                control.one_large.effective_gb_s, control.many_small.effective_gb_s
+            );
+
+            Ok(Qwen38DispatchSizeSweep {
+                kernel: packed.kernel.to_owned(),
+                codec: "HGRAVF01 affine2 q2".to_owned(),
+                geometry: "tpr64_tg128".to_owned(),
+                projection: "mlp.gate_proj.weight".to_owned(),
+                group_size: packed.group_size,
+                bits: packed.bits,
+                cols: packed.cols,
+                unit_rows,
+                unit_weight_bytes,
+                bytes_per_row,
+                warmup,
+                reps,
+                pack_parity_max_abs_diff,
+                pack_parity_bit_identical,
+                curve,
+                control,
+                timing: "MTLCommandBuffer GPUStartTime/GPUEndTime",
+                arithmetic: "y = affine2_q2(W, x) on a known x; identical kernel; rows stacked from catalog gate_proj",
+            })
+        }
