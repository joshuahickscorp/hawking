@@ -0,0 +1,197 @@
+//! Bytes-per-dispatch sweep on one affine2 kernel, one representation.
+//!
+//! Stacks real `mlp.gate_proj` catalog rows into a single GEMV and varies
+//! only the launched working set (~5, ~20, ~50, ~100, ~200, ~338, ~700 MB).
+//! GPU time is `GPUEndTime - GPUStartTime` on the command buffer (the n1 /
+//! p1 region-timing approach). A size-vs-shape control at the LM head's
+//! ~338 MB compares one concatenated launch against the same bytes as many
+//! unit tensors.
+//!
+//! Does not mutate the production decode path.
+//!
+//! ```text
+//! cargo build --profile release-fast -p hawking-core --example dispatch_size_sweep
+//! ./workspace/ops/build/rust/release-fast/examples/dispatch_size_sweep \
+//!   --artifact-root ~/noetic/NOETIC_PARENT_A \
+//!   --out receipts/future/_DISPATCH_SIZE_SWEEP_raw.json
+//! ```
+
+use serde_json::{json, Value};
+use std::env;
+use std::fs;
+use std::path::PathBuf;
+use std::process;
+
+fn usage() -> &'static str {
+    "usage: dispatch_size_sweep --artifact-root DIR \
+        [--warmup N] [--reps N] [--out FILE]"
+}
+
+fn fail(message: impl std::fmt::Display) -> ! {
+    eprintln!("dispatch_size_sweep: {message}");
+    process::exit(2);
+}
+
+struct Args {
+    artifact_root: PathBuf,
+    warmup: usize,
+    reps: usize,
+    out: Option<PathBuf>,
+}
+
+fn parse_args() -> Args {
+    let mut artifact_root = None;
+    let mut warmup = 5usize;
+    let mut reps = 11usize;
+    let mut out = None;
+    let mut args = env::args().skip(1);
+    while let Some(flag) = args.next() {
+        match flag.as_str() {
+            "--artifact-root" => {
+                artifact_root = Some(PathBuf::from(args.next().unwrap_or_else(|| fail(usage()))));
+            }
+            "--warmup" => {
+                warmup = args
+                    .next()
+                    .unwrap_or_else(|| fail(usage()))
+                    .parse()
+                    .unwrap_or_else(|_| fail("--warmup"));
+            }
+            "--reps" => {
+                reps = args
+                    .next()
+                    .unwrap_or_else(|| fail(usage()))
+                    .parse()
+                    .unwrap_or_else(|_| fail("--reps"));
+            }
+            "--out" => out = Some(PathBuf::from(args.next().unwrap_or_else(|| fail(usage())))),
+            other => fail(format!("unknown {other}; {}", usage())),
+        }
+    }
+    if reps < 9 {
+        fail("--reps must be >= 9");
+    }
+    Args {
+        artifact_root: artifact_root.unwrap_or_else(|| fail(usage())),
+        warmup,
+        reps,
+        out,
+    }
+}
+
+fn git_head() -> String {
+    std::process::Command::new("git")
+        .args(["rev-parse", "HEAD"])
+        .output()
+        .ok()
+        .and_then(|o| String::from_utf8(o.stdout).ok())
+        .map(|s| s.trim().to_string())
+        .unwrap_or_default()
+}
+
+fn point_json(p: &hawking_core::model::qwen38_hybrid_decode::Qwen38DispatchSizePoint) -> Value {
+    json!({
+        "label": p.label,
+        "target_mb": p.target_mb,
+        "weight_bytes": p.weight_bytes,
+        "rows": p.rows,
+        "cols": p.cols,
+        "n_source_tensors": p.n_source_tensors,
+        "dispatches": p.dispatches,
+        "encoders": p.encoders,
+        "command_buffers": p.command_buffers,
+        "gpu_ns_median": p.gpu_ns_median,
+        "gpu_ns_reps": p.gpu_ns_reps,
+        "effective_gb_s": p.effective_gb_s,
+        "mb_per_dispatch": p.mb_per_dispatch,
+    })
+}
+
+#[cfg(target_os = "macos")]
+fn run(args: Args) -> Value {
+    use hawking_core::model::qwen38_hybrid_decode::Qwen38HybridDecodeSession;
+
+    eprintln!(
+        "dispatch_size_sweep opening {} warmup={} reps={}",
+        args.artifact_root.display(),
+        args.warmup,
+        args.reps
+    );
+    let session = Qwen38HybridDecodeSession::open(&args.artifact_root, 8).unwrap_or_else(|e| fail(e));
+    let measured = session
+        .measure_dispatch_size_sweep(args.warmup, args.reps)
+        .unwrap_or_else(|e| fail(e));
+    eprintln!(
+        "  kernel={} codec={} geometry={} unit_rows={} unit_bytes={}",
+        measured.kernel,
+        measured.codec,
+        measured.geometry,
+        measured.unit_rows,
+        measured.unit_weight_bytes
+    );
+    for p in &measured.curve {
+        eprintln!(
+            "  curve {:.1} MB  {:.1} GB/s  {} ns  {} disp",
+            p.mb_per_dispatch, p.effective_gb_s, p.gpu_ns_median, p.dispatches
+        );
+    }
+    eprintln!(
+        "  control one_large {:.1} GB/s  many_small {:.1} GB/s  bit_identical={}",
+        measured.control.one_large.effective_gb_s,
+        measured.control.many_small.effective_gb_s,
+        measured.control.bit_identical
+    );
+    json!({
+        "schema": "hawking.future.dispatch_size_sweep.raw.v1",
+        "git_head": git_head(),
+        "artifact_root": args.artifact_root.display().to_string(),
+        "kernel": measured.kernel,
+        "codec": measured.codec,
+        "geometry": measured.geometry,
+        "projection": measured.projection,
+        "group_size": measured.group_size,
+        "bits": measured.bits,
+        "cols": measured.cols,
+        "unit_rows": measured.unit_rows,
+        "unit_weight_bytes": measured.unit_weight_bytes,
+        "bytes_per_row": measured.bytes_per_row,
+        "warmup": measured.warmup,
+        "reps": measured.reps,
+        "pack_parity_max_abs_diff": measured.pack_parity_max_abs_diff,
+        "pack_parity_bit_identical": measured.pack_parity_bit_identical,
+        "curve": measured.curve.iter().map(point_json).collect::<Vec<_>>(),
+        "control": {
+            "total_weight_bytes": measured.control.total_weight_bytes,
+            "n_unit_tensors": measured.control.n_unit_tensors,
+            "unit_rows": measured.control.unit_rows,
+            "one_large": point_json(&measured.control.one_large),
+            "many_small": point_json(&measured.control.many_small),
+            "max_abs_diff": measured.control.max_abs_diff,
+            "bit_identical": measured.control.bit_identical,
+        },
+        "timing": measured.timing,
+        "arithmetic": measured.arithmetic,
+    })
+}
+
+#[cfg(not(target_os = "macos"))]
+fn run(_args: Args) -> Value {
+    fail("dispatch_size_sweep is Metal-only")
+}
+
+fn main() {
+    let args = parse_args();
+    let out = args.out.clone();
+    let doc = run(args);
+    let text = serde_json::to_string_pretty(&doc).unwrap_or_else(|e| fail(e));
+    println!("{text}");
+    if let Some(path) = out {
+        if let Some(parent) = path.parent() {
+            if !parent.as_os_str().is_empty() {
+                fs::create_dir_all(parent).unwrap_or_else(|e| fail(e));
+            }
+        }
+        fs::write(&path, format!("{text}\n")).unwrap_or_else(|e| fail(e));
+        eprintln!("wrote {}", path.display());
+    }
+}
