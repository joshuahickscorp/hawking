+
+        fn dispatch_affine_at(
+            &self,
+            tcb: &mut TokenCommandBuffer<'_>,
+            packed: &PackedAffineRowStack,
+            rows: u32,
+            codes_off: u64,
+            scales_off: u64,
+            biases_off: u64,
+            input: &PinnedBuffer,
+            output: &PinnedBuffer,
+            output_off: u64,
+        ) -> Result<()> {
+            if packed.bits != 2 || !affine_group_size_supported(packed.group_size as usize) {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep refuses bits={} group_size={}",
+                    packed.bits, packed.group_size
+                )));
+            }
+            // Pin tpr64: this measurement holds kernel + tile geometry fixed.
+            let (name, grid, tg) = qwen38_affine_q2_launch(
+                Affine2Geo::Tpr64,
+                packed.group_size,
+                rows,
+                packed.cols,
+            )
+            .ok_or_else(|| {
+                mixed_error(format!(
+                    "dispatch size sweep: no tpr64 launch for rows={rows} cols={} g={}",
+                    packed.cols, packed.group_size
+                ))
+            })?;
+            tcb.dispatch_threads(name, grid, tg, |enc| {
+                self.encode_affine_args_at(
+                    enc,
+                    &packed.staging,
+                    codes_off,
+                    scales_off,
+                    biases_off,
+                    rows,
+                    packed.cols,
+                    packed.group_size,
+                    input,
+                    output,
+                    output_off,
+                )
+            })
+        }
+
+        fn require_gpu_ns(timing: &CommandBufferTiming, label: &str) -> Result<u64> {
+            timing.gpu_ns.ok_or_else(|| {
+                mixed_error(format!(
+                    "{label}: driver did not expose GPUEndTime-GPUStartTime"
+                ))
+            })
+        }
+
+        fn median_gpu_ns(values: &[u64]) -> Result<u64> {
+            if values.is_empty() {
+                return Err(mixed_error("dispatch size sweep: empty GPU sample"));
+            }
+            let mut sorted = values.to_vec();
+            sorted.sort_unstable();
+            Ok(sorted[sorted.len() / 2])
+        }
+
+        fn dispatch_size_point(
+            label: String,
+            target_mb: f64,
+            weight_bytes: u64,
+            rows: u32,
+            cols: u32,
+            n_source_tensors: usize,
+            samples: &[u64],
+            dispatches: u64,
+            encoders: u64,
+            command_buffers: u64,
+        ) -> Result<Qwen38DispatchSizePoint> {
+            let gpu_ns_median = Self::median_gpu_ns(samples)?;
+            let effective_gb_s = if gpu_ns_median == 0 {
+                0.0
+            } else {
+                weight_bytes as f64 / gpu_ns_median as f64
+            };
+            let mb_per_dispatch =
+                weight_bytes as f64 / 1e6 / (dispatches.max(1) as f64);
+            Ok(Qwen38DispatchSizePoint {
+                label,
+                target_mb,
+                weight_bytes,
+                rows,
+                cols,
+                n_source_tensors,
+                dispatches,
+                encoders,
+                command_buffers,
+                gpu_ns_median,
+                gpu_ns_reps: samples.to_vec(),
+                effective_gb_s,
+                mb_per_dispatch,
+            })
+        }
+
+        fn affine_row_layout(body: &GpuAffine) -> Result<(u64, u64, u64)> {
+            let rows = body.rows as u64;
+            if rows == 0 {
+                return Err(mixed_error("dispatch size sweep: empty affine rows"));
+            }
+            let biases = body.biases.as_ref().ok_or_else(|| {
+                mixed_error("dispatch size sweep refuses delta-only (q2f) tensors")
+            })?;
+            let codes = body.codes.length();
+            let scales = body.scales.length();
+            let bias_len = biases.length();
+            if codes % rows != 0 || scales % rows != 0 || bias_len % rows != 0 {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep: affine layout is not row-major \
+                     (rows={rows} codes={codes} scales={scales} biases={bias_len})"
+                )));
+            }
+            Ok((codes / rows, scales / rows, bias_len / rows))
+        }
+
+        fn pack_affine_row_stack(
+            &self,
+            sources: &[&GpuAffine],
+            want_rows: u32,
+        ) -> Result<PackedAffineRowStack> {
+            if sources.is_empty() || want_rows == 0 {
+                return Err(mixed_error(
+                    "dispatch size sweep: need at least one source row",
+                ));
+            }
+            let proto = sources[0];
+            let (cpr, spr, bpr) = Self::affine_row_layout(proto)?;
+            let bytes_per_row = cpr + spr + bpr;
+            for (i, body) in sources.iter().enumerate() {
+                if body.cols != proto.cols
+                    || body.group_size != proto.group_size
+                    || body.bits != proto.bits
+                {
+                    return Err(mixed_error(format!(
+                        "dispatch size sweep: source {i} geometry drifted"
+                    )));
+                }
+                let layout = Self::affine_row_layout(body)?;
+                if layout != (cpr, spr, bpr) {
+                    return Err(mixed_error(format!(
+                        "dispatch size sweep: source {i} row layout drifted"
+                    )));
+                }
+            }
+            let available: u32 = sources.iter().map(|b| b.rows).sum();
+            if want_rows > available {
+                return Err(mixed_error(format!(
+                    "dispatch size sweep: want {want_rows} rows, catalog has {available}"
+                )));
+            }
+            let (name, _, _) = qwen38_affine_q2_launch(
+                Affine2Geo::Tpr64,
+                proto.group_size,
+                want_rows,
+                proto.cols,
+            )
+            .ok_or_else(|| mixed_error("dispatch size sweep: tpr64 launch unavailable"))?;
+
+            const ALIGN: u64 = 256;
+            let codes_bytes = cpr * want_rows as u64;
+            let scales_bytes = spr * want_rows as u64;
+            let biases_bytes = bpr * want_rows as u64;
+            let codes_off = 0u64;
+            let scales_off = align_up(codes_off + codes_bytes, ALIGN);
+            let biases_off = align_up(scales_off + scales_bytes, ALIGN);
+            let staging_len = (biases_off + biases_bytes).max(ALIGN) as usize;
+            let staging = self.context.new_buffer_checked(staging_len)?;
+            let output = self
+                .context
+                .new_buffer_checked((want_rows as usize) * std::mem::size_of::<f32>())?;
+
+            let mut copied = 0u32;
+            let mut src_i = 0usize;
+            let mut src_row = 0u32;
+            while copied < want_rows {
+                let body = sources[src_i];
+                if src_row >= body.rows {
+                    src_i += 1;
+                    src_row = 0;
+                    continue;
+                }
+                let take = (body.rows - src_row).min(want_rows - copied);
+                let src_off_rows = src_row as u64;
+                let dst_off_rows = copied as u64;
+                host_copy_bytes(
+                    &body.codes,
+                    (src_off_rows * cpr) as usize,
+                    &staging,
+                    (codes_off + dst_off_rows * cpr) as usize,
+                    (take as u64 * cpr) as usize,
+                );
+                host_copy_bytes(
+                    &body.scales,
+                    (src_off_rows * spr) as usize,
+                    &staging,
+                    (scales_off + dst_off_rows * spr) as usize,
+                    (take as u64 * spr) as usize,
+                );
+                let biases = body.biases.as_ref().expect("affine_row_layout required bias");
+                host_copy_bytes(
+                    biases,
+                    (src_off_rows * bpr) as usize,
+                    &staging,
+                    (biases_off + dst_off_rows * bpr) as usize,
+                    (take as u64 * bpr) as usize,
+                );
+                copied += take;
+                src_row += take;
+            }
+
+            Ok(PackedAffineRowStack {
+                staging,
+                output,
+                codes_off,
+                scales_off,
+                biases_off,
+                codes_per_row: cpr,
+                scales_per_row: spr,
+                biases_per_row: bpr,
+                bytes_per_row,
+                rows: want_rows,
+                cols: proto.cols,
+                group_size: proto.group_size,
+                bits: proto.bits,
+                unit_rows: proto.rows,
+                kernel: name,
+                n_source_tensors: src_i + 1,
+            })
+        }
+
+        fn encode_packed_one_dispatch(
+            &self,
+            tcb: &mut TokenCommandBuffer<'_>,
+            packed: &PackedAffineRowStack,
+            rows: u32,
+        ) -> Result<()> {
+            tcb.begin_serial_group()?;
+            tcb.use_resources_read_on_group(&[packed.staging.clone()])?;
+            self.dispatch_affine_at(
+                tcb,
+                packed,
+                rows,
+                packed.codes_off,
+                packed.scales_off,
+                packed.biases_off,
+                &self.workspace.normalized,
+                &packed.output,
+                0,
+            )?;
+            tcb.end_serial_group()
+        }
+
+        fn encode_packed_many_small(
+            &self,
+            tcb: &mut TokenCommandBuffer<'_>,
+            packed: &PackedAffineRowStack,
+            n_unit: usize,
+        ) -> Result<()> {
+            let unit = packed.unit_rows;
+            tcb.begin_serial_group()?;
+            tcb.use_resources_read_on_group(&[packed.staging.clone()])?;
+            for i in 0..n_unit {
+                let i = i as u64;
+                let codes_off = packed.codes_off + i * unit as u64 * packed.codes_per_row;
+                let scales_off = packed.scales_off + i * unit as u64 * packed.scales_per_row;
+                let biases_off = packed.biases_off + i * unit as u64 * packed.biases_per_row;
+                let output_off = i * unit as u64 * 4;
+                self.dispatch_affine_at(
+                    tcb,
+                    packed,
+                    unit,
+                    codes_off,
+                    scales_off,
+                    biases_off,
+                    &self.workspace.normalized,
+                    &packed.output,
+                    output_off,
+                )?;
+            }
+            tcb.end_serial_group()
