+/// Target working sets (MB, 10^6 bytes) for the bytes-per-dispatch sweep.
+/// Includes the LM head's 337.7 MB/launch and a point past it.
+pub const QWEN38_DISPATCH_SIZE_TARGETS_MB: [f64; 7] =
+    [5.0, 20.0, 50.0, 100.0, 200.0, 337.7, 700.0];
+
+/// One timed point: a single affine2 GEMV launch of `rows` catalog rows.
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct Qwen38DispatchSizePoint {
+    pub label: String,
+    pub target_mb: f64,
+    pub weight_bytes: u64,
+    pub rows: u32,
+    pub cols: u32,
+    pub n_source_tensors: usize,
+    pub dispatches: u64,
+    pub encoders: u64,
+    pub command_buffers: u64,
+    pub gpu_ns_median: u64,
+    pub gpu_ns_reps: Vec<u64>,
+    pub effective_gb_s: f64,
+    pub mb_per_dispatch: f64,
+}
+
+/// Same total bytes, two shapes: one concatenated GEMV vs many unit GEMVs.
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct Qwen38DispatchSizeControl {
+    pub total_weight_bytes: u64,
+    pub n_unit_tensors: usize,
+    pub unit_rows: u32,
+    pub one_large: Qwen38DispatchSizePoint,
+    pub many_small: Qwen38DispatchSizePoint,
+    pub max_abs_diff: f32,
+    pub bit_identical: bool,
+}
+
+/// Bytes-per-dispatch sweep on one kernel and one representation.
+///
+/// Stacks real `mlp.gate_proj` HGRAVF01 affine2 rows into one GEMV and
+/// varies only the launched working set. Does not change the default
+/// decode path.
+#[derive(Clone, Debug, serde::Serialize)]
+pub struct Qwen38DispatchSizeSweep {
+    pub kernel: String,
+    pub codec: String,
+    pub geometry: String,
+    pub projection: String,
+    pub group_size: u32,
+    pub bits: u32,
+    pub cols: u32,
+    pub unit_rows: u32,
+    pub unit_weight_bytes: u64,
+    pub bytes_per_row: u64,
+    pub warmup: usize,
+    pub reps: usize,
+    pub pack_parity_max_abs_diff: f32,
+    pub pack_parity_bit_identical: bool,
+    pub curve: Vec<Qwen38DispatchSizePoint>,
+    pub control: Qwen38DispatchSizeControl,
+    pub timing: &'static str,
+    pub arithmetic: &'static str,
+}
+
 fn mixed_error(message: impl Into<String>) -> Error {
     Error::Model(format!("qwen38 mixed hybrid decode: {}", message.into()))
 }
