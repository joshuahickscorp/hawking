+        fn encode_affine_args_at(
+            &self,
+            enc: &metal::ComputeCommandEncoderRef,
+            staging: &PinnedBuffer,
+            codes_off: u64,
+            scales_off: u64,
+            biases_off: u64,
+            rows: u32,
+            cols: u32,
+            group_size: u32,
+            input: &PinnedBuffer,
+            output: &PinnedBuffer,
+            output_off: u64,
+        ) {
+            enc.set_buffer(0, Some(staging), codes_off);
+            enc.set_buffer(1, Some(staging), scales_off);
+            enc.set_buffer(2, Some(staging), biases_off);
+            enc.set_buffer(3, Some(input), 0);
+            enc.set_buffer(4, Some(output), output_off);
+            set_u32(enc, 5, rows);
+            set_u32(enc, 6, cols);
