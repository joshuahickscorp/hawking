+#[cfg(test)]
+mod dispatch_ceremony_env_tests {
+    use super::*;
+
+    #[test]
+    fn prefill_skip_terminal_and_serial_encoder_parse_without_silent_fallthrough() {
+        const SKIP: &str = "HAWKING_QWEN38_PREFILL_SKIP_TERMINAL";
+        const SERIAL: &str = "HAWKING_QWEN38_SERIAL_TOKEN_ENCODER";
+        let restore_skip = std::env::var(SKIP).ok();
+        let restore_serial = std::env::var(SERIAL).ok();
+
+        std::env::remove_var(SKIP);
+        assert!(
+            qwen38_prefill_skip_terminal_from_env(),
+            "unset must skip discarded lm_head on teacher-forced prefill"
+        );
+        std::env::set_var(SKIP, "1");
+        assert!(qwen38_prefill_skip_terminal_from_env());
+        std::env::set_var(SKIP, "0");
+        assert!(
+            !qwen38_prefill_skip_terminal_from_env(),
+            "Off must stay reachable so the full-terminal prefill baseline can be measured"
+        );
+        std::env::set_var(SKIP, "skippy");
+        let skip_typo = std::panic::catch_unwind(qwen38_prefill_skip_terminal_from_env);
+        std::env::remove_var(SKIP);
+        assert!(skip_typo.is_err(), "an unrecognised skip-terminal value must panic");
+
+        std::env::remove_var(SERIAL);
+        assert!(
+            !qwen38_serial_token_encoder_from_env(),
+            "serial encoder stays Off: GPU_IDLE_GAP_LEDGER did not separate 580→1"
+        );
+        std::env::set_var(SERIAL, "1");
+        assert!(qwen38_serial_token_encoder_from_env());
+        std::env::set_var(SERIAL, "0");
+        assert!(!qwen38_serial_token_encoder_from_env());
+        std::env::set_var(SERIAL, "seriall");
+        let serial_typo = std::panic::catch_unwind(qwen38_serial_token_encoder_from_env);
+        std::env::remove_var(SERIAL);
+        assert!(serial_typo.is_err(), "an unrecognised serial-encoder value must panic");
+
+        match restore_skip {
+            Some(v) => std::env::set_var(SKIP, v),
+            None => std::env::remove_var(SKIP),
+        }
+        match restore_serial {
+            Some(v) => std::env::set_var(SERIAL, v),
+            None => std::env::remove_var(SERIAL),
+        }
+    }
+}
