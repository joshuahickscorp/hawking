+/// One serial compute encoder covering the token graph. Default Off: the
+/// idle-gap ledger already ran encoder_count 580→1 and it did not separate
+/// complete-wall from the per-dispatch encoder (GPU_IDLE_GAP_LEDGER).
+///
+/// `HAWKING_QWEN38_SERIAL_TOKEN_ENCODER=1` (or true/on/yes) — opt in
+/// `=0` / unset                                          — production
+/// anything else                                          — PANICS
+pub fn qwen38_serial_token_encoder_from_env() -> bool {
+    match std::env::var("HAWKING_QWEN38_SERIAL_TOKEN_ENCODER") {
+        Ok(v) => match v.trim().to_ascii_lowercase().as_str() {
+            "" | "0" | "off" | "false" | "no" => false,
+            "1" | "true" | "on" | "yes" => true,
+            other => panic!(
+                "HAWKING_QWEN38_SERIAL_TOKEN_ENCODER={other:?} is not a recognised value; \
+                 use 1 | 0. Falling back to Off here would silently measure the \
+                 multi-encoder graph."
+            ),
+        },
+        Err(_) => false,
+    }
+}
+
+/// Skip lm_head + argmax on teacher-forced prefill steps that do not emit a
+/// generated token. Default On: those steps discard `sampled` today, and the
+/// next token is the next prompt id, not the argmax. KV / DeltaNet state is
+/// still written by embed+layers.
+///
+/// `HAWKING_QWEN38_PREFILL_SKIP_TERMINAL=0` — full graph every prompt step
+/// unset / `=1`                             — skip terminal on non-last prefill
+/// anything else                            — PANICS
+pub fn qwen38_prefill_skip_terminal_from_env() -> bool {
+    match std::env::var("HAWKING_QWEN38_PREFILL_SKIP_TERMINAL") {
+        Ok(v) => match v.trim().to_ascii_lowercase().as_str() {
+            "0" | "off" | "false" | "no" => false,
+            "" | "1" | "true" | "on" | "yes" => true,
+            other => panic!(
+                "HAWKING_QWEN38_PREFILL_SKIP_TERMINAL={other:?} is not a recognised value; \
+                 use 1 | 0. Falling back to Off here would silently keep lm_head \
+                 on teacher-forced prefill."
+            ),
+        },
+        Err(_) => true,
+    }
+}
