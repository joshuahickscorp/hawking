+                    value.trim().to_ascii_lowercase().as_str(),
+                    "1" | "true" | "on" | "yes"
+                )
+            })
+            .unwrap_or(false);
+        let fused_hc_router = env::var("HAWKING_FLASH_HC_ROUTER_FUSED")
