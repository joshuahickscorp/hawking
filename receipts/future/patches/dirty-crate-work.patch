+            const float value = scratch[dim];
+            q_sum += value * value;
+        }
+        scratch[2u * head_dim] = 1.0f / sqrt(q_sum / float(head_dim) + rms_epsilon);
+        if (head < n_kv_heads) {
+            float k_sum = 0.0f;
+            for (uint dim = 0u; dim < head_dim; ++dim) {
+                const float value = scratch[head_dim + dim];
+                k_sum += value * value;
