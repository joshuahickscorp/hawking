+    fn sha256(bytes: &[u8]) -> String {
+        format!("{:x}", Sha256::digest(bytes))
+    }
+
+    fn bf16(bytes: &[u8], index: usize) -> f32 {
+        let offset = index * 2;
+        f32::from_bits((u16::from_le_bytes([bytes[offset], bytes[offset + 1]]) as u32) << 16)
+    }
+
