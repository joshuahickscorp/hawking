+    fn repeat_streams(input: &[f32]) -> Vec<f32> {
+        let mut output = Vec::with_capacity(HC_ELEMENTS);
+        for _ in 0..STREAMS {
+            output.extend_from_slice(input);
+        }
+        output
+    }
