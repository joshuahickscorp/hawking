+            hc_mlp_block: source_buffer(ctx, &weights.hc_mlp_block)?,
+            expert_lut: weights
+                .expert_lut
+                .as_ref()
+                .map(|lut| {
+                    source_buffer(
+                        ctx,
+                        &Tensor {
+                            name: "expert_lut".into(),
+                            shape: vec![lut.len()],
+                            bytes: u32_bytes(lut),
+                            sha256: sha256_bytes(&u32_bytes(lut)),
+                        },
+                    )
+                })
+                .transpose()?,
+            expert_count: weights
+                .expert_gate_up
+                .shape
+                .first()
+                .copied()
+                .unwrap_or(EXPERTS),
+        })
+    }
