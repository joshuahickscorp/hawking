+            (TG_SIZE, 1, 1),
+            |enc| {
+                enc.set_buffer(0, Some(input), 0);
+                enc.set_buffer(1, Some(output), 0);
+                enc.set_u32(2, elements as u32);
+                enc.set_f32(3, divisor);
+            },
+        )
+    }
