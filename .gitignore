# Semantic graph, viewer and topology analyses now live under /workspace/ops/build (ignored
# above): all deterministic, ~41s to regenerate with
# tools/graph/hawking_graph.py --emit all

# Instrument models for the TG gauntlet: fetched, transformed, sealed by
# receipt, then evicted. Never committed; workspace/campaign/evidence/runtime/tg/ carries their hashes.
/workspace/ops/local/models/*.gguf

# Keep transient process output out of the compact repository root.
/workspace/ops/logs/

# pnpm workspace state under the relocated ops tree: regenerated on install,
# and the root-anchored /node_modules/ rule above does not reach it.
/workspace/ops/node_modules/

# 52 MB GLM52 shard dependency graph. Regenerable campaign evidence, too large
# to belong in a public repository; the receipt beside it carries its hash.
/workspace/campaign/evidence/models/glm52/GLM52_SHARD_DEPENDENCY_GRAPH.json

# HCLI live runtime state (sessions, memory.db, sqlite indices). Regenerated
# per run, not source.
/.hide/

# python venv (never commit; self-symlink hazard)
/tools/condense/.venv/
/tools/condense/.venv

# real GLM float exports — large binary, correctly excluded from git, but lives inside
# the repo tree (not a worktree-only path) so it survives worktree cleanup
/workspace/campaign/evidence/models/frankenstein/glm-floats-safe/

# Physical gravity artifacts: multi-GB payload bodies and their receipts live on
# disk as evidence, never in git (this has always been the practice -- nothing
# under physical/ has ever been tracked). Named explicitly so a stray `git add -A`
# cannot commit a 5.9 GB candidate.
workspace/campaign/records/ascension-sandbox/physical/**/selected-payloads/
workspace/campaign/records/ascension-sandbox/physical/**/*.hgravs01
workspace/campaign/records/ascension-sandbox/physical/**/tensors/
