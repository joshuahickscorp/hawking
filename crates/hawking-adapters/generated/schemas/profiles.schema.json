{
  "$id": "hawking.profiles.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "KernelProfile": {
      "properties": {
        "device_name": {
          "type": "string"
        },
        "evidence": {
          "type": "object"
        },
        "model_arch": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_name": {
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "selected": {
          "type": "object"
        },
        "shader_hash": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "profile_name",
        "model_arch",
        "selected"
      ],
      "type": "object"
    },
    "RuntimeProfile": {
      "enum": [
        "default",
        "fast",
        "race",
        "efficient",
        "exact"
      ],
      "type": "string"
    }
  },
  "description": "Runtime lever profiles (CLI --profile) and kernel-profile JSON shape.",
  "oneOf": [
    {
      "$ref": "#/definitions/RuntimeProfile"
    },
    {
      "$ref": "#/definitions/KernelProfile"
    }
  ],
  "title": "HawkingRuntimeAndKernelProfiles"
}
